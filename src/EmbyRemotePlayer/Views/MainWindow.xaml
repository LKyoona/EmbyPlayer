<Window x:Class="EmbyRemotePlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EmbyRemotePlayer.Models"
        xmlns:vm="clr-namespace:EmbyRemotePlayer.ViewModels"
        Title="Emby Remote Player" Icon="pack://application:,,,/Assets/emby.ico" Width="1320" Height="840" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        TextElement.Foreground="White"
        TextElement.FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>

        <LinearGradientBrush x:Key="MainBackdropBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF090B17" Offset="0"/>
            <GradientStop Color="#FF12162B" Offset="0.48"/>
            <GradientStop Color="#FF22172F" Offset="1"/>
        </LinearGradientBrush>

        <DataTemplate x:Key="ServerProfileTemplate" DataType="{x:Type models:ServerProfile}">
            <Border Background="{StaticResource GlassBrush}" BorderBrush="#44FFFFFF" BorderThickness="1"
                    CornerRadius="22" Padding="22" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" Background="#24FFFFFF" BorderBrush="#3CFFFFFF" BorderThickness="1" VerticalAlignment="Top">
                        <Image Source="pack://application:,,,/Assets/emby.png" Width="30" Height="30" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="6,0,20,0">
                        <TextBlock Text="{Binding FriendlyName}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding UserName}" Foreground="White" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding ServerUrl}" Foreground="White" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="删除" Style="{StaticResource TextButton}" Tag="{Binding}" Click="DeleteProfileButton_Click" Margin="0,0,4,0"/>
                        <Button Content="编辑" Style="{StaticResource TextButton}" Tag="{Binding}" Click="EditProfileButton_Click" Margin="0,0,8,0"/>
                        <Button Content="进入" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="ConnectProfileButton_Click" MinWidth="88"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PosterCardTemplate" DataType="{x:Type vm:MediaCardViewModel}">
            <Button Style="{StaticResource CardButton}" Tag="{Binding}" Click="MediaCard_Click" MouseEnter="MediaCard_MouseEnter" Width="164" Margin="0,0,18,24">
                <StackPanel>
                    <Border Height="236" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                            CornerRadius="17" ClipToBounds="True">
                        <Grid>
                            <Image Source="pack://application:,,,/Assets/emby.png" Width="46" Height="46" Opacity="0.16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                            <Border VerticalAlignment="Bottom" Height="82">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#CC090B15" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Background="#B0191E2D" BorderBrush="#3FFFFFFF" BorderThickness="1" CornerRadius="9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,4"
                                    Visibility="{Binding Badge, Converter={x:Static vm:StringVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <ProgressBar Height="4" VerticalAlignment="Bottom" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolVisibility}}"
                                         BorderThickness="0" Foreground="#FF5FB3FF"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontFamily="Microsoft YaHei UI" FontWeight="Bold" FontSize="14" Margin="3,12,3,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#B8FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Normal" Margin="3,4,3,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="LandscapeCardTemplate" DataType="{x:Type vm:MediaCardViewModel}">
            <Button Style="{StaticResource CardButton}" Tag="{Binding}" Click="MediaCard_Click" MouseEnter="MediaCard_MouseEnter" Width="304" Margin="0,0,18,24">
                <StackPanel>
                    <Border Height="171" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                            CornerRadius="18" ClipToBounds="True">
                        <Grid>
                            <Image Source="pack://application:,,,/Assets/emby.png" Width="54" Height="54" Opacity="0.14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                            <Border VerticalAlignment="Bottom" Padding="15,42,15,14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#E20A0D18" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontFamily="Microsoft YaHei UI" FontWeight="Bold" FontSize="16"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#B8FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Normal" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                </StackPanel>
                            </Border>
                            <ProgressBar Height="4" VerticalAlignment="Bottom" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolVisibility}}"
                                         BorderThickness="0" Foreground="#FF5FB3FF"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource MainBackdropBrush}">
        <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-390,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush><GradientStop Color="#343D79D6" Offset="0"/><GradientStop Color="#003D79D6" Offset="1"/></RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="680" Height="680" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-250,-380" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush><GradientStop Color="#304F1E72" Offset="0"/><GradientStop Color="#004F1E72" Offset="1"/></RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Server switcher -->
        <Grid x:Name="ServerPanel" Background="Transparent">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="68,52,68,26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/emby.png" Width="30" Height="30" Stretch="Uniform" Margin="0,0,11,0"/>
                        <TextBlock Text="EMBY REMOTE PLAYER" Foreground="White" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="服务器" Style="{StaticResource PageTitle}" Foreground="White" Margin="0,12,0,0"/>
                    <TextBlock Text="连接你的媒体空间。账号令牌仅保存在本机 Windows 凭据管理器。"
                               Foreground="White" FontSize="15" Margin="0,11,0,0"/>
                </StackPanel>
                <Button Content="＋ 添加服务器" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="AddServerButton_Click"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Width="790" HorizontalAlignment="Center" Margin="0,10,0,64">
                    <ItemsControl x:Name="ProfilesItemsControl" ItemTemplate="{StaticResource ServerProfileTemplate}"/>
                    <Border x:Name="EmptyProfilesCard" Background="{StaticResource GlassBrush}" BorderBrush="#44FFFFFF" BorderThickness="1"
                            CornerRadius="24" Padding="54" Visibility="Collapsed" Effect="{StaticResource GlassShadow}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="66" Height="66" CornerRadius="21" Background="#24FFFFFF" BorderBrush="#45FFFFFF" BorderThickness="1">
                                <Image Source="pack://application:,,,/Assets/emby.png" Width="42" Height="42" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="还没有服务器" FontSize="23" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            <TextBlock Text="添加服务器后即可浏览和播放 Emby 媒体库。" Foreground="White" Margin="0,10,0,24"/>
                            <Button Content="添加第一个服务器" Style="{StaticResource PrimaryButton}" Click="AddServerButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Login / add profile -->
        <Grid x:Name="LoginPanel" Background="Transparent" Visibility="Collapsed">
            <Button Content="← 返回" Style="{StaticResource TextButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30" Click="BackToServersButton_Click"/>
            <Border Width="500" Background="{StaticResource GlassBrush}" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="28"
                    Padding="44" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource GlassShadow}">
                <Grid>
                    <Border Background="{StaticResource GlassBrightBrush}" CornerRadius="27" IsHitTestVisible="False"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="pack://application:,,,/Assets/emby.png" Width="40" Height="40" Stretch="Uniform" Margin="0,0,13,0"/>
                            <TextBlock Text="连接 Emby" FontSize="31" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="输入服务器地址和 Emby 账号。" Foreground="White" Margin="0,8,0,28"/>
                        <TextBlock Text="显示名称" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBox x:Name="DisplayNameTextBox" Margin="0,0,0,17"/>
                        <TextBlock Text="服务器地址" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBox x:Name="ServerUrlTextBox" Margin="0,0,0,17" ToolTip="例如：https://emby.example.com 或 http://192.168.1.10:8096"/>
                        <TextBlock Text="用户名" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBox x:Name="UsernameTextBox" Margin="0,0,0,17"/>
                        <TextBlock Text="密码" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,18" KeyDown="PasswordInput_KeyDown"/>
                        <CheckBox x:Name="AutoConnectCheckBox" Content="下次自动连接" Foreground="White" Margin="2,0,0,20"/>
                        <TextBlock x:Name="LoginErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,14" Visibility="Collapsed"/>
                        <Button x:Name="LoginButton" Content="连接并登录" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Main application -->
        <Grid x:Name="AppPanel" Visibility="Collapsed">
            <Grid x:Name="AppContentRoot">
                <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Margin="16" Background="{StaticResource GlassBrush}" BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="24" Effect="{StaticResource CardShadow}">
                    <Grid Margin="20,27,20,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/emby.png" Width="31" Height="31" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Emby" Foreground="White" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CurrentServerText" Foreground="#9FFFFFFF" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,29,0,0">
                            <Button Content="⌂  首页" Style="{StaticResource NavButton}" Click="HomeButton_Click"/>
                            <Button Content="▦  媒体库" Style="{StaticResource NavButton}" Click="LibrariesButton_Click"/>
                            <Button Content="♡  收藏" Style="{StaticResource NavButton}" Click="FavoritesButton_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3">
                            <Button Content="网络调试  ·  F12" Style="{StaticResource TextButton}" Click="OpenDebugConsoleButton_Click" Margin="0,0,0,8"/>
                            <Button Content="切换服务器" Style="{StaticResource SecondaryButton}" Click="SwitchServerButton_Click" Margin="0,0,0,8"/>
                            <Button Content="退出账号" Style="{StaticResource TextButton}" Click="LogoutButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main/browse page. Detail navigation replaces this page instead of opening a modal layer. -->
                <Grid x:Name="MainPageContainer" Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="30,20,34,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitleText" Text="首页" FontSize="27" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="你的个人媒体空间" Foreground="#92FFFFFF" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="SearchTextBox" Grid.Column="1" VerticalAlignment="Center" KeyDown="SearchTextBox_KeyDown" ToolTip="搜索电影、剧集和视频"/>
                        <Button Grid.Column="2" Content="搜索" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="SearchButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PreviewMouseWheel="VerticalScroll_PreviewMouseWheel">
                            <StackPanel Margin="30,16,34,62">
                                <TextBlock Text="继续观看" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                <TextBlock x:Name="ContinueEmptyText" Text="没有未看完的内容" Foreground="#78FFFFFF" Margin="0,0,0,24" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="ContinueScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" Margin="0,0,0,20" ScrollChanged="ContinueScroll_ScrollChanged">
                                    <ItemsControl x:Name="ContinueItemsControl" ItemTemplate="{StaticResource LandscapeCardTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="最新电影" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                <ScrollViewer x:Name="LatestMoviesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" Margin="0,0,0,20" ScrollChanged="LatestMoviesScroll_ScrollChanged">
                                    <ItemsControl x:Name="LatestMoviesItemsControl" ItemTemplate="{StaticResource PosterCardTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="最新剧集" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                <ScrollViewer x:Name="LatestEpisodesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="LatestEpisodesScroll_ScrollChanged">
                                    <ItemsControl x:Name="LatestEpisodesItemsControl" ItemTemplate="{StaticResource PosterCardTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="BrowseScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed" ScrollChanged="BrowseScroll_ScrollChanged" PreviewMouseWheel="VerticalScroll_PreviewMouseWheel">
                            <StackPanel Margin="30,16,34,62">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Button x:Name="BrowseBackButton" Content="← 返回" Style="{StaticResource TextButton}" Click="BrowseBackButton_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="BrowseStatusText" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl x:Name="BrowseItemsControl" ItemTemplate="{StaticResource PosterCardTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="BrowseEmptyText" Text="这里还没有内容" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,70,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="BusyOverlay" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Width="230" Background="#E626293A" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,10,26,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel>
                                    <ProgressBar Width="190" Height="3" IsIndeterminate="True" BorderThickness="0"/>
                                    <TextBlock x:Name="BusyText" Text="正在加载…" Foreground="White" HorizontalAlignment="Center" Margin="0,9,0,0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Native in-window detail page: no modal, no blur, no second window. -->
                <Grid x:Name="DetailPage" Grid.Column="1" Visibility="Collapsed" Background="#FF0A0C17">
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" ScrollChanged="DetailScroll_ScrollChanged" PreviewMouseWheel="VerticalScroll_PreviewMouseWheel">
                        <StackPanel>
                            <!-- Hero -->
                            <Grid Height="360" Background="#171A28" ClipToBounds="True">
                                <Image x:Name="DetailBackdropImage" Stretch="UniformToFill"/>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#26080A13" Offset="0"/>
                                            <GradientStop Color="#16080A13" Offset="0.42"/>
                                            <GradientStop Color="#E80A0C17" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,24" CornerRadius="22" Background="#8C202435" BorderBrush="#48FFFFFF" BorderThickness="1">
                                    <Button Content="←  返回" Style="{StaticResource TextButton}" Padding="16,10" Click="DetailBackButton_Click"/>
                                </Border>
                                <Image x:Name="DetailLogoImage" MaxWidth="360" MaxHeight="110" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="40,0,40,42"/>
                            </Grid>

                            <StackPanel Margin="36,0,42,72" MaxWidth="1120">
                                <!-- title / metadata / actions -->
                                <Grid Margin="0,-12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="DetailTitleText" FontSize="38" FontWeight="Bold" LineHeight="45" Foreground="White"/>
                                        <TextBlock x:Name="DetailOriginalTitleText" Foreground="White" FontSize="14" Margin="0,6,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="DetailMetaText" Foreground="White" FontSize="15" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="DetailUserStateText" Foreground="White" FontSize="12" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="PlayButton" Grid.Column="1" Content="▶  播放" Style="{StaticResource PrimaryButton}" Click="PlayButton_Click" MouseEnter="PlayButton_MouseEnter"
                                            FontSize="16" MinWidth="170" Height="52" VerticalAlignment="Bottom" Margin="28,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,22,0,0" Visibility="Collapsed" x:Name="DetailProgressPanel">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="DetailProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" BorderThickness="0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailProgressText" Grid.Column="1" Margin="16,0,0,0" Foreground="White" FontSize="12"/>
                                </Grid>

                                <TextBlock x:Name="DetailTaglineText" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,26,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="DetailOverviewText" FontSize="15" LineHeight="26" Foreground="White" Margin="0,16,0,0" MaxWidth="1030"/>
                                <TextBlock x:Name="DetailErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed"/>

                                <!-- Version -->
                                <StackPanel Margin="0,30,0,0">
                                    <TextBlock Text="媒体版本" Style="{StaticResource SectionTitle}" Foreground="White" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="MediaSourceComboBox" MinHeight="50" SelectionChanged="MediaSourceComboBox_SelectionChanged"/>
                                </StackPanel>

                                <!-- Selected source technical summary -->
                                <Border Margin="0,18,0,0" Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="视频" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock x:Name="DetailVideoText" Foreground="White" FontSize="13" LineHeight="22" Margin="0,8,22,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="文件 / 播放能力" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock x:Name="DetailTechnicalText" Foreground="White" FontSize="13" LineHeight="22" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- audio/subtitle -->
                                <Grid Margin="0,26,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="音轨" Style="{StaticResource SectionTitle}" Foreground="White" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="DetailAudioItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#10FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,0,0,8">
                                                        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding Subtitle}" Foreground="#9FFFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="字幕" Style="{StaticResource SectionTitle}" Foreground="White" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="DetailSubtitleItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#10FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,0,0,8">
                                                        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding Subtitle}" Foreground="#9FFFFFFF" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- Episodes -->
                                <StackPanel x:Name="DetailEpisodesSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="DetailEpisodesTitle" Text="本季剧集" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ScrollViewer x:Name="DetailEpisodesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="DetailEpisodesScroll_ScrollChanged">
                                        <ItemsControl x:Name="DetailEpisodesItemsControl">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CardButton}" Tag="{Binding}" Click="DetailRelatedCard_Click" Width="258" Margin="0,0,14,14">
                                                        <StackPanel>
                                                            <Border Height="145" Background="#17FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="pack://application:,,,/Assets/emby.png" Width="38" Height="38" Opacity="0.12"/>
                                                                    <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                                                    <Border VerticalAlignment="Bottom" Background="#B80A0C15" Padding="12,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/></Border>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="#9FFFFFFF" FontSize="12" Margin="2,7,2,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Chapters -->
                                <StackPanel x:Name="DetailChaptersSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock Text="章节" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ItemsControl x:Name="DetailChaptersItemsControl">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#13FFFFFF" BorderBrush="#2FFFFFFF" BorderThickness="1" CornerRadius="13" Padding="13,9" Margin="0,0,9,9">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Foreground="White"/><TextBlock Text="{Binding TimeText}" Foreground="White" Margin="8,0,0,0"/></StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Cast -->
                                <StackPanel x:Name="DetailPeopleSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock Text="演职人员" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ScrollViewer x:Name="DetailPeopleScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="DetailPeopleScroll_ScrollChanged">
                                        <ItemsControl x:Name="DetailPeopleItemsControl">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="116" Margin="0,0,16,12">
                                                        <Border Width="92" Height="92" CornerRadius="18" Background="#16FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left">
                                                            <Grid><Image Source="pack://application:,,,/Assets/emby.png" Width="30" Height="30" Opacity="0.10"/><Image Source="{Binding Image}" Stretch="UniformToFill"/></Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" Margin="1,9,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                                        <TextBlock Text="{Binding Role}" Foreground="White" FontSize="11" Margin="1,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Similar -->
                                <StackPanel x:Name="DetailSimilarSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock Text="相似作品" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ScrollViewer x:Name="DetailSimilarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="DetailSimilarScroll_ScrollChanged">
                                        <ItemsControl x:Name="DetailSimilarItemsControl">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CardButton}" Tag="{Binding}" Click="DetailRelatedCard_Click" Width="148" Margin="0,0,14,18">
                                                        <StackPanel>
                                                            <Border Height="214" Background="#17FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                                <Grid><Image Source="pack://application:,,,/Assets/emby.png" Width="38" Height="38" Opacity="0.12"/><Image Source="{Binding Image}" Stretch="UniformToFill"/></Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" Margin="2,8,2,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="White" FontSize="11" Margin="2,3,2,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Studios / locations / links -->
                                <Grid Margin="0,28,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel x:Name="DetailStudiosSection" Visibility="Collapsed">
                                        <TextBlock Text="工作室" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                        <TextBlock x:Name="DetailStudiosText" Foreground="White" FontSize="14" LineHeight="24"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DetailLocationsSection" Grid.Column="2" Visibility="Collapsed">
                                        <TextBlock Text="制作地区" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                        <TextBlock x:Name="DetailLocationsText" Foreground="White" FontSize="14" LineHeight="24"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="DetailLinksSection" Margin="0,26,0,0" Visibility="Collapsed">
                                    <TextBlock Text="链接" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ItemsControl x:Name="DetailLinksItemsControl">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}" Tag="{Binding Url}" Style="{StaticResource SecondaryButton}" Click="ExternalLink_Click" Padding="16,8" Margin="0,0,9,9" MinHeight="38"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel x:Name="DetailInfoSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock Text="更多信息" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ItemsControl x:Name="DetailInfoItemsControl">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="510" MinHeight="58" Background="#0DFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="13" Padding="14,10" Margin="0,0,12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PlaybackInfo/media-source negotiation happens before the player window exists.
                         Surface that async work instead of making the detail page look frozen. -->
                    <Border x:Name="DetailPlayBusyOverlay" Visibility="Collapsed" Background="#7A050505" Panel.ZIndex="40">
                        <StackPanel Width="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="180" Height="3" IsIndeterminate="True" BorderThickness="0"/>
                            <TextBlock x:Name="DetailPlayBusyText" Text="正在准备播放…" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="正在获取媒体地址和播放能力" Foreground="#AFFFFFFF" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>