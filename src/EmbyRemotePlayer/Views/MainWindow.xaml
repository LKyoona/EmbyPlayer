<Window x:Class="EmbyRemotePlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EmbyRemotePlayer.Models"
        xmlns:vm="clr-namespace:EmbyRemotePlayer.ViewModels"
        xmlns:conv="clr-namespace:EmbyRemotePlayer.Converters"
        Title="Emby Remote · 私人影院" Icon="pack://application:,,,/Assets/emby.ico" Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        TextElement.Foreground="White"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>

        <LinearGradientBrush x:Key="MainBackdropBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF090A0E" Offset="0"/>
            <GradientStop Color="#FF07080B" Offset="0.55"/>
            <GradientStop Color="#FF050507" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="MainSearchTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#990A84FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchFrame" Background="#D913151D" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="SearchIcon" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="#88FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 14.5,14.5 L 19,19 M 16.5,10 A 6.5,6.5 0 1 1 3.5,10 A 6.5,6.5 0 1 1 16.5,10"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="2,0,8,0"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              HorizontalContentAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchFrame" Property="Background" Value="#FF1A1D27"/>
                                <Setter TargetName="SearchFrame" Property="BorderBrush" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SearchFrame" Property="Background" Value="#FF111319"/>
                                <Setter TargetName="SearchFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SearchIcon" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ServerProfileTemplate" DataType="{x:Type models:ServerProfile}">
            <Border Background="{StaticResource GlassBrush}" BorderBrush="#26FFFFFF" BorderThickness="1"
                    CornerRadius="18" Padding="22" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#240A84FF" BorderBrush="#600A84FF" BorderThickness="1" VerticalAlignment="Top">
                        <Image Source="pack://application:,,,/Assets/emby.png" Width="30" Height="30" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="6,0,20,0">
                        <TextBlock Text="{Binding FriendlyName}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding UserName}" Foreground="#FFC6D0DC" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding ServerUrl}" Foreground="#FF85858B" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="删除" Style="{StaticResource TextButton}" Tag="{Binding}" Click="DeleteProfileButton_Click" Margin="0,0,4,0"/>
                        <Button Content="编辑" Style="{StaticResource TextButton}" Tag="{Binding}" Click="EditProfileButton_Click" Margin="0,0,8,0"/>
                        <Button Content="进入" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="ConnectProfileButton_Click" MinWidth="88"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PosterCardTemplate" DataType="{x:Type vm:MediaCardViewModel}">
            <Button x:Name="CardShell" Style="{StaticResource CardButton}" Tag="{Binding}" Click="MediaCard_Click" MouseEnter="MediaCard_MouseEnter"
                    AutomationProperties.Name="{Binding Title}" Width="182" Margin="0,0,16,14">
                <StackPanel>
                    <Border Height="273" Background="#FF13151B" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <!-- Minimalist modern media placeholder -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#20FFFFFF">
                                    <Path Fill="White" Data="{StaticResource GeoPlay}" Stretch="Uniform" Width="14" Height="14" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Mismatched-aspect fallback artwork renders complete (Uniform) over a
                                 blurred self-fill; matched posters collapse the blur layer for free. -->
                            <Image Source="{Binding Image}" Stretch="UniformToFill" Opacity="0.4"
                                   Visibility="{Binding Image, Converter={x:Static conv:ImageAspectMismatchConverter.Instance}, ConverterParameter=0.667}">
                                <Image.Effect>
                                    <BlurEffect Radius="30" RenderingBias="Performance"/>
                                </Image.Effect>
                            </Image>
                            <Image Source="{Binding Image}" Stretch="Uniform"/>
                            <Path x:Name="LoadingArc" Data="M 11 2.5 A 8.5 8.5 0 0 1 19.5 11" Stroke="#99FFFFFF" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingSpin" CenterX="11" CenterY="11"/>
                                </Path.RenderTransform>
                            </Path>
                            <Border Background="#D9090A0D" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="7,3"
                                    Visibility="{Binding Badge, Converter={x:Static conv:StringVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#CC0A0E18" BorderBrush="#400A84FF" BorderThickness="1" CornerRadius="6"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3"
                                    Visibility="{Binding TypeBadge, Converter={x:Static conv:StringVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TypeBadge}" Foreground="#FFF5F8FA" FontSize="9.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PosterPlayBadge" Width="40" Height="40" CornerRadius="20" Background="#F00A84FF"
                                    BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,10,10" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Border.RenderTransform>
                                <Path Fill="White" Data="{StaticResource GeoPlay}" Stretch="Uniform" Width="15" Height="15" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Height="3.5" VerticalAlignment="Bottom" Margin="8,0,8,6" CornerRadius="2" ClipToBounds="True" Background="#33FFFFFF"
                                    Visibility="{Binding HasProgress, Converter={StaticResource BoolVisibility}}">
                                <ProgressBar Height="3.5" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             BorderThickness="0" Foreground="{StaticResource AccentBrush}" Background="Transparent"/>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="#FFF4F4F5" FontWeight="SemiBold" FontSize="14" LineHeight="19"
                               Margin="2,10,2,0" MaxHeight="38" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#88FFFFFF" FontSize="12" Margin="2,4,2,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardShell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="PosterPlayBadge" Property="Opacity" Value="1"/>
                    <Setter TargetName="PosterPlayBadge" Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding ShowImageLoading}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PosterCardLoadingSpin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LoadingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.85" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="PosterCardLoadingSpin"/>
                    </DataTrigger.ExitActions>
                    <Setter TargetName="LoadingArc" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LandscapeCardTemplate" DataType="{x:Type vm:MediaCardViewModel}">
            <Button x:Name="CardShell" Style="{StaticResource CardButton}" Tag="{Binding}" Click="MediaCard_Click" MouseEnter="MediaCard_MouseEnter"
                    AutomationProperties.Name="{Binding Title}" Width="336" Margin="0,0,18,14">
                <StackPanel>
                    <Border Height="189" Background="#FF13151B" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <!-- Minimalist modern media placeholder -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#20FFFFFF">
                                    <Path Fill="White" Data="{StaticResource GeoPlay}" Stretch="Uniform" Width="16" Height="16" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Image Source="{Binding Image}" Stretch="UniformToFill" Opacity="0.4"
                                   Visibility="{Binding Image, Converter={x:Static conv:ImageAspectMismatchConverter.Instance}, ConverterParameter=1.778}">
                                <Image.Effect>
                                    <BlurEffect Radius="30" RenderingBias="Performance"/>
                                </Image.Effect>
                            </Image>
                            <Image Source="{Binding Image}" Stretch="Uniform"/>
                            <Path x:Name="LoadingArc" Data="M 13 3 A 10 10 0 0 1 23 13" Stroke="#99FFFFFF" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingSpin" CenterX="12" CenterY="12"/>
                                </Path.RenderTransform>
                            </Path>
                            <Border VerticalAlignment="Bottom" Height="72" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#A606070A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="LandscapePlayBadge" Width="44" Height="44" CornerRadius="22" Background="#F00A84FF"
                                    BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,10,0" Opacity="0">
                                <Path Fill="White" Data="{StaticResource GeoPlay}" Stretch="Uniform" Width="16" Height="16" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#CC0A0E18" BorderBrush="#400A84FF" BorderThickness="1" CornerRadius="6"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="7,3"
                                    Visibility="{Binding TypeBadge, Converter={x:Static conv:StringVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TypeBadge}" Foreground="#FFF5F8FA" FontSize="9.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Height="3.5" VerticalAlignment="Bottom" Margin="10,0,10,8" CornerRadius="2" ClipToBounds="True" Background="#33FFFFFF"
                                    Visibility="{Binding HasProgress, Converter={StaticResource BoolVisibility}}">
                                <ProgressBar Height="3.5" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             BorderThickness="0" Foreground="{StaticResource AccentBrush}" Background="Transparent"/>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="#FFF4F4F5" FontWeight="SemiBold" FontSize="14.5" LineHeight="20"
                               Margin="2,10,8,0" MaxHeight="40" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#88FFFFFF" FontSize="12" Margin="2,4,8,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardShell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="LandscapePlayBadge" Property="Opacity" Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding ShowImageLoading}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="LandscapeCardLoadingSpin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LoadingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.85" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="LandscapeCardLoadingSpin"/>
                    </DataTrigger.ExitActions>
                    <Setter TargetName="LoadingArc" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PosterRowTemplate" DataType="{x:Type vm:HomeRowViewModel}">
            <StackPanel Margin="0,0,0,34">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFFFF" FontSize="21" FontWeight="Bold" FontFamily="{StaticResource AppTitleFontFamily}"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="#77FFFFFF" FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Bottom"
                                   Visibility="{Binding Subtitle, Converter={x:Static conv:StringVisibilityConverter.Instance}}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding BadgeText, Converter={x:Static conv:StringVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding BadgeText}" Foreground="#CCFFFFFF" FontSize="11" FontWeight="Medium"/>
                    </Border>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                              PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="DynamicHomeRow_ScrollChanged">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource PosterCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LandscapeRowTemplate" DataType="{x:Type vm:HomeRowViewModel}">
            <StackPanel Margin="0,0,0,36">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFFFF" FontSize="21" FontWeight="Bold" FontFamily="{StaticResource AppTitleFontFamily}"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="#77FFFFFF" FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Bottom"
                                   Visibility="{Binding Subtitle, Converter={x:Static conv:StringVisibilityConverter.Instance}}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#1E0A84FF" BorderBrush="#450A84FF" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center"
                            Visibility="{Binding BadgeText, Converter={x:Static conv:StringVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding BadgeText}" Foreground="#FFD6EBFF" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                              PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="DynamicHomeRow_ScrollChanged">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource LandscapeCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <vm:HomeRowTemplateSelector x:Key="HomeRowSelector"
                                    PosterRowTemplate="{StaticResource PosterRowTemplate}"
                                    LandscapeRowTemplate="{StaticResource LandscapeRowTemplate}"/>
    </Window.Resources>

    <Grid Background="{StaticResource MainBackdropBrush}">
        <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-420,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush><GradientStop Color="#240A84FF" Offset="0"/><GradientStop Color="#000A84FF" Offset="1"/></RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="680" Height="680" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-250,-380" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush><GradientStop Color="#160A84FF" Offset="0"/><GradientStop Color="#000A84FF" Offset="1"/></RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Server switcher -->
        <Grid x:Name="ServerPanel" Background="Transparent">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="76,58,76,30">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/emby.png" Width="30" Height="30" Stretch="Uniform" Margin="0,0,11,0"/>
                        <TextBlock Text="EMBY REMOTE  ·  PRIVATE CINEMA" Foreground="#FFA8B4C2" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="选择你的媒体空间" Style="{StaticResource PageTitle}" Foreground="White" Margin="0,14,0,0"/>
                    <TextBlock Text="连接你的媒体空间。账号令牌仅保存在本机 Windows 凭据管理器。"
                               Foreground="#FF9B9BA1" FontSize="15" Margin="0,10,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="AddServerButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Fill="White" Data="M 19,13 L 13,13 L 13,19 L 11,19 L 11,13 L 5,13 L 5,11 L 11,11 L 11,5 L 13,5 L 13,11 L 19,11 Z" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="添加服务器" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Width="820" HorizontalAlignment="Center" Margin="0,12,0,70">
                    <ItemsControl x:Name="ProfilesItemsControl" ItemTemplate="{StaticResource ServerProfileTemplate}"/>
                    <Border x:Name="EmptyProfilesCard" Background="{StaticResource GlassBrush}" BorderBrush="#44FFFFFF" BorderThickness="1"
                            CornerRadius="28" Padding="60" Visibility="Collapsed" Effect="{StaticResource GlassShadow}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="22" Background="#240A84FF" BorderBrush="#600A84FF" BorderThickness="1">
                                <Image Source="pack://application:,,,/Assets/emby.png" Width="42" Height="42" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="还没有服务器" FontSize="23" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            <TextBlock Text="添加服务器后，即刻进入属于你的私人影院。" Foreground="#FF9B9BA1" Margin="0,10,0,26"/>
                            <Button Content="添加第一个服务器" Style="{StaticResource PrimaryButton}" Click="AddServerButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Login / add profile -->
        <Grid x:Name="LoginPanel" Background="Transparent" Visibility="Collapsed">
            <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34" Click="BackToServersButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoArrowLeft}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="返回服务器" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Border Width="520" Background="{StaticResource GlassBrush}" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="30"
                    Padding="48" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource GlassShadow}">
                <Grid>
                    <Border Background="{StaticResource GlassBrightBrush}" CornerRadius="27" IsHitTestVisible="False"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="pack://application:,,,/Assets/emby.png" Width="40" Height="40" Stretch="Uniform" Margin="0,0,13,0"/>
                            <TextBlock Text="连接 Emby" FontSize="32" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="安全连接你的服务器，继续私人观影旅程。" Foreground="#FF9B9BA1" Margin="0,8,0,30"/>
                        <TextBlock Text="显示名称" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBox x:Name="DisplayNameTextBox" Margin="0,0,0,17"/>
                        <TextBlock Text="服务器地址" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBox x:Name="ServerUrlTextBox" Margin="0,0,0,17" ToolTip="例如：https://emby.example.com 或 http://192.168.1.10:8096"/>
                        <TextBlock Text="用户名" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBox x:Name="UsernameTextBox" Margin="0,0,0,17"/>
                        <TextBlock Text="密码" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,18" KeyDown="PasswordInput_KeyDown"/>
                        <CheckBox x:Name="AutoConnectCheckBox" Content="下次自动连接" Foreground="White" Margin="2,0,0,20"/>
                        <TextBlock x:Name="LoginErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,14" Visibility="Collapsed"/>
                        <Button x:Name="LoginButton" Content="连接并登录" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Main application -->
        <Grid x:Name="AppPanel" Visibility="Collapsed">
            <Grid x:Name="AppContentRoot">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="SidebarBorder" Width="218" Background="#FA080A0E" BorderBrush="#1CFFFFFF" BorderThickness="0,0,1,0" ClipToBounds="True">
                    <Grid x:Name="SidebarInnerGrid" Margin="14,24,14,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header / Brand & User Avatar & Toggle -->
                        <StackPanel>
                            <Grid x:Name="SidebarHeaderGrid" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="UserAvatarButton" Style="{StaticResource TextButton}" Padding="0" Click="UserAvatarButton_Click" HorizontalAlignment="Left" ToolTip="用户个人空间">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- User Avatar (Circle container) -->
                                        <Grid Width="38" Height="38">
                                            <!-- Fallback Initials Circle -->
                                            <Border x:Name="UserAvatarInitialsCircle" Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Effect="{StaticResource AccentGlow}">
                                                <TextBlock x:Name="UserAvatarInitialsText" Text="U" Foreground="White" FontSize="16" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Real Avatar Image -->
                                            <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True">
                                                <Image x:Name="UserAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                            </Border>
                                            <!-- Subtle outline -->
                                            <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#35FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
                                        </Grid>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" x:Name="SidebarBrandText">
                                            <TextBlock x:Name="SidebarUserNameText" Text="Emby 用户" Foreground="White" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                            <TextBlock x:Name="SidebarServerBadgeText" Text="REMOTE CINEMA" Foreground="#FF888890" FontSize="9.5" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SidebarToggleButton" Grid.Column="1" Style="{StaticResource TextButton}" Width="32" Height="32" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Right" Click="SidebarToggleButton_Click" ToolTip="收起侧边栏 (Ctrl+B)">
                                    <Path x:Name="SidebarToggleIcon" Fill="#88FFFFFF" Stretch="Uniform" Width="14" Height="14"
                                          Data="M 3,4 L 21,4 C 21.55,4 22,4.45 22,5 L 22,19 C 22,19.55 21.55,20 21,20 L 3,20 C 2.45,20 2,19.55 2,19 L 2,5 C 2,4.45 2.45,4 3,4 Z M 8,6 L 4,6 L 4,18 L 8,18 Z"/>
                                </Button>
                            </Grid>
                            <!-- Mini Toggle button visible only when collapsed -->
                            <Button x:Name="SidebarMiniExpandButton" Style="{StaticResource TextButton}" Width="36" Height="30" Padding="0" Margin="0,8,0,0" Click="SidebarToggleButton_Click" Visibility="Collapsed" HorizontalAlignment="Center" ToolTip="展开侧边栏 (Ctrl+B)">
                                <Path Fill="#88FFFFFF" Stretch="Uniform" Width="14" Height="14" Data="M 3,4 L 21,4 C 21.55,4 22,4.45 22,5 L 22,19 C 22,19.55 21.55,20 21,20 L 3,20 C 2.45,20 2,19.55 2,19 L 2,5 C 2,4.45 2.45,4 3,4 Z M 16,6 L 20,6 L 20,18 L 16,18 Z"/>
                            </Button>
                            <Border x:Name="SidebarServerBox" Background="#1E0A84FF" BorderBrush="#450A84FF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="●  当前媒体空间" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CurrentServerText" Foreground="#FFD0D0D3" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="AppVersionText" Foreground="#667F7F85" FontSize="10" Margin="2,7,0,0"/>
                        </StackPanel>
                        
                        <!-- Navigation Items -->
                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <TextBlock x:Name="SidebarNavBrowseHeader" Text="浏览" Foreground="#FF6F6F76" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,8"/>
                            <Button x:Name="HomeNavButton" Tag="Active" Style="{StaticResource NavButton}" Click="HomeButton_Click" ToolTip="首页" AutomationProperties.Name="首页">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path x:Name="HomeNavIcon" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoHome}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomeNavText" Grid.Column="1" Text="首页" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="LibrariesNavButton" Style="{StaticResource NavButton}" Click="LibrariesButton_Click" ToolTip="媒体库" AutomationProperties.Name="媒体库">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path x:Name="LibrariesNavIcon" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoLibrary}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LibrariesNavText" Grid.Column="1" Text="媒体库" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="FavoritesNavButton" Style="{StaticResource NavButton}" Click="FavoritesButton_Click" ToolTip="我的收藏" AutomationProperties.Name="我的收藏">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path x:Name="FavoritesNavIcon" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoHeart}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FavoritesNavText" Grid.Column="1" Text="我的收藏" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                        
                        <!-- Bottom Action Items (Expanded) -->
                        <StackPanel Grid.Row="3" x:Name="SidebarBottomExpanded">
                            <Button Content="网络状态  ·  F12" Style="{StaticResource TextButton}" Click="OpenDebugConsoleButton_Click" Margin="0,0,0,8" ToolTip="查看网络请求和播放器诊断"/>
                            <Button Style="{StaticResource SecondaryButton}" Click="SwitchServerButton_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="White" Data="{StaticResource GeoServer}" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="切换媒体空间" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Click="LogoutButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoLogout}" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="退出当前账号" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Bottom Compact Items (Collapsed) -->
                        <StackPanel Grid.Row="3" x:Name="SidebarBottomCollapsed" Visibility="Collapsed" HorizontalAlignment="Center">
                            <Button Style="{StaticResource TextButton}" Width="40" Height="40" Padding="0" Click="OpenDebugConsoleButton_Click" Margin="0,0,0,6" ToolTip="网络状态 (F12)">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoSpeed}" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Width="40" Height="40" Padding="0" Click="SwitchServerButton_Click" Margin="0,0,0,6" ToolTip="切换媒体空间">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoServer}" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Width="40" Height="40" Padding="0" Click="LogoutButton_Click" ToolTip="退出当前账号">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoLogout}" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main/browse page. Detail navigation replaces this page instead of opening a modal layer. -->
                <Grid x:Name="MainPageContainer" Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="32,14,36,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitleText" Text="首页" FontSize="26" FontWeight="Bold" FontFamily="{StaticResource AppTitleFontFamily}" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Height="40" Width="360" VerticalAlignment="Center">
                            <TextBox x:Name="SearchTextBox" Style="{StaticResource MainSearchTextBox}" KeyDown="SearchTextBox_KeyDown" TextChanged="SearchTextBox_TextChanged"
                                     AutomationProperties.Name="搜索电影、剧集和人物" AutomationProperties.HelpText="按 Enter 开始搜索"
                                     ToolTip="搜索电影、剧集和人物（Ctrl+F / Ctrl+K）"/>
                            <TextBlock x:Name="SearchPlaceholderText" Text="搜索电影、剧集、人物…" Foreground="#FF7D7D86" FontSize="13" Margin="38,0,42,0"
                                       HorizontalAlignment="Stretch" TextAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Button x:Name="SearchButton" Style="{StaticResource TextButton}" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Click="SearchButton_Click" ToolTip="开始搜索">
                                <Path Fill="#88FFFFFF" Data="{StaticResource GeoSearch}" Stretch="Uniform" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PreviewMouseWheel="VerticalScroll_PreviewMouseWheel" ScrollChanged="HomeScroll_ScrollChanged">
                            <StackPanel Margin="32,8,36,72">
                                <!-- Hero Billboard Banner (~460DIP) with dual-layer smooth cross-fade -->
                                <Border x:Name="HeroPanel" Height="460" CornerRadius="20" Margin="0,0,0,32" ClipToBounds="True" Background="#FF0D0E12" Visibility="Collapsed">
                                    <Grid>
                                        <Image x:Name="HeroBackdropImageB" Stretch="UniformToFill" Opacity="0"/>
                                        <Image x:Name="HeroBackdropImageA" Stretch="UniformToFill" Opacity="1"/>

                                        <!-- Left-to-right cinematic gradient for text contrast -->
                                        <Border IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#F808090C" Offset="0"/>
                                                    <GradientStop Color="#DE08090C" Offset="0.32"/>
                                                    <GradientStop Color="#8808090C" Offset="0.6"/>
                                                    <GradientStop Color="#0008090C" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Bottom gradient overlay to blend into the canvas seamlessly -->
                                        <Border VerticalAlignment="Bottom" Height="160" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="#8008090C" Offset="0.5"/>
                                                    <GradientStop Color="#F808090C" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Content Column -->
                                        <Grid Margin="48,36,48,32">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel MaxWidth="680" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Image x:Name="HeroLogoImage" MaxHeight="96" MaxWidth="420" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,16" Visibility="Collapsed"/>
                                                <TextBlock x:Name="HeroTitleText" FontSize="38" FontWeight="Bold" FontFamily="{StaticResource AppTitleFontFamily}" Foreground="White" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,12"/>

                                                <!-- Meta: Year · Rating · Genres -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Border x:Name="HeroBadgeBorder" Background="#260A84FF" BorderBrush="#550A84FF" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="HeroBadgeText" Text="热门精选" Foreground="#FFD6EBFF" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock x:Name="HeroMetaText" Foreground="#FFD0D0D5" FontSize="13.5" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Overview 3-line clamp -->
                                                <TextBlock x:Name="HeroOverviewText" Foreground="#FFB0B0B8" FontSize="14" LineHeight="22" MaxHeight="66" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0,0,0,24"/>

                                                <!-- Action Buttons: Apple TV style -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="HeroPlayButton" Style="{StaticResource HeroPlayPillButton}" Height="46" Margin="0,0,14,0" Click="HeroPlayButton_Click">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Fill="#FF0A0B0E" Data="{StaticResource GeoPlay}" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="立即播放" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="HeroDetailsButton" Style="{StaticResource HeroGlassPillButton}" Height="46" Click="HeroDetailsButton_Click">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Fill="White" Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 13,17 L 11,17 L 11,11 L 13,11 Z M 13,9 L 11,9 L 11,7 L 13,7 Z" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="更多信息" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Indicators (dots) -->
                                            <StackPanel x:Name="HeroIndicatorsPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="HomeEmptyStateText" Text="你的媒体空间还没有准备好内容" Foreground="#78FFFFFF" FontSize="16" HorizontalAlignment="Center" Margin="0,80,0,0" Visibility="Collapsed"/>
                                <ItemsControl x:Name="HomeRowsItemsControl" ItemTemplateSelector="{StaticResource HomeRowSelector}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="BrowseScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed" ScrollChanged="BrowseScroll_ScrollChanged" PreviewMouseWheel="VerticalScroll_PreviewMouseWheel">
                            <StackPanel Margin="32,12,36,72">
                                <Border Background="#D90D0D0F" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,22">
                                    <Grid>
                                        <Button x:Name="BrowseBackButton" Style="{StaticResource TextButton}" Click="BrowseBackButton_Click" Visibility="Collapsed" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoArrowLeft}" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="返回" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Border HorizontalAlignment="Right" Background="#240A84FF" BorderBrush="#550A84FF" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                            <TextBlock x:Name="BrowseStatusText" Foreground="#FFD6EBFF" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="BrowseItemsControl" ItemTemplate="{StaticResource PosterCardTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel x:Name="SearchSectionsStack" Visibility="Collapsed"/>
                                <TextBlock x:Name="BrowseEmptyText" Text="这里还没有内容" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,70,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="BusyOverlay" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Width="230" Background="#EE121722" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,10,26,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel>
                                    <ProgressBar Width="190" Height="3" IsIndeterminate="True" BorderThickness="0" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock x:Name="BusyText" Text="正在加载…" Foreground="White" HorizontalAlignment="Center" Margin="0,9,0,0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Non-blocking error toast: flaky servers must never interrupt with modal dialogs. -->
                        <Border x:Name="MainErrorToast" Background="#F2221820" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="10"
                                Padding="16,11" Margin="0,64,26,0" MaxWidth="480" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="MainErrorToast_Click" ToolTip="点击关闭">
                            <StackPanel>
                                <TextBlock x:Name="MainErrorTitle" Text="加载失败" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="MainErrorText" Foreground="#FFC9C9C9" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Native in-window detail page: no modal, no blur, no second window. -->
                <Grid x:Name="DetailPage" Grid.Column="1" Visibility="Collapsed" Background="#FF070708">
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" ScrollChanged="DetailScroll_ScrollChanged" PreviewMouseWheel="VerticalScroll_PreviewMouseWheel">
                        <StackPanel>
                            <!-- Hero -->
                            <Grid Height="430" Background="#FF111113" ClipToBounds="True">
                                <Image x:Name="DetailBackdropImage" Stretch="UniformToFill"/>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#16070708" Offset="0"/>
                                        <GradientStop Color="#32070708" Offset="0.42"/>
                                        <GradientStop Color="#FF070708" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,26" CornerRadius="14" Background="#C90D141D" BorderBrush="#38FFFFFF" BorderThickness="1">
                                    <Button Style="{StaticResource TextButton}" Padding="16,10" Click="DetailBackButton_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GeoArrowLeft}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="返回浏览" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <Image x:Name="DetailLogoImage" MaxWidth="420" MaxHeight="130" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="40,0,40,58"/>
                            </Grid>

                            <StackPanel Margin="42,0,48,84" MaxWidth="1160">
                                <!-- title / metadata / actions -->
                                <Grid Margin="0,-18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="DetailTitleText" FontSize="42" FontWeight="SemiBold" LineHeight="50" Foreground="White"/>
                                        <TextBlock x:Name="DetailOriginalTitleText" Foreground="#FF9B9BA1" FontSize="14" Margin="0,7,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="DetailMetaText" Foreground="#FFD5DDE6" FontSize="15" Margin="0,13,0,0"/>
                                        <TextBlock x:Name="DetailUserStateText" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="PlayButton_Click" MouseEnter="PlayButton_MouseEnter"
                                            FontSize="16" MinWidth="184" Height="54" VerticalAlignment="Bottom" Margin="30,0,0,0" ToolTip="开始播放（Enter）">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Fill="White" Data="{StaticResource GeoPlay}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="播放" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,22,0,0" Visibility="Collapsed" x:Name="DetailProgressPanel">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="DetailProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" BorderThickness="0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailProgressText" Grid.Column="1" Margin="16,0,0,0" Foreground="#FFB6C2CE" FontSize="12"/>
                                </Grid>

                                <TextBlock x:Name="DetailTaglineText" FontSize="18" FontWeight="SemiBold" Foreground="#FFE7EDF4" Margin="0,28,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="DetailOverviewText" FontSize="15" LineHeight="28" Foreground="#FFB4BFCC" Margin="0,16,0,0" MaxWidth="1060"/>
                                <TextBlock x:Name="DetailErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed"/>

                                <!-- Version -->
                                <StackPanel Margin="0,30,0,0">
                                    <TextBlock Text="媒体版本" Style="{StaticResource SectionTitle}" Foreground="White" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="MediaSourceComboBox" MinHeight="50" SelectionChanged="MediaSourceComboBox_SelectionChanged"/>
                                </StackPanel>

                                <!-- Selected source technical summary -->
                                <Border Margin="0,18,0,0" Background="#B8101721" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="18" Padding="22">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="视频" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock x:Name="DetailVideoText" Foreground="#FFBDBDC2" FontSize="13" LineHeight="23" Margin="0,8,22,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="文件 / 播放能力" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock x:Name="DetailTechnicalText" Foreground="#FFBDBDC2" FontSize="13" LineHeight="23" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- audio/subtitle -->
                                <Grid Margin="0,26,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="音轨" Style="{StaticResource SectionTitle}" Foreground="White" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="DetailAudioItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#A8101721" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                                                        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding Subtitle}" Foreground="#FF909096" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="字幕" Style="{StaticResource SectionTitle}" Foreground="White" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="DetailSubtitleItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#A8101721" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                                                        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding Subtitle}" Foreground="#FF909096" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- Episodes -->
                                <StackPanel x:Name="DetailEpisodesSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="DetailEpisodesTitle" Text="本季剧集" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ScrollViewer x:Name="DetailEpisodesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="DetailEpisodesScroll_ScrollChanged">
                                        <ItemsControl x:Name="DetailEpisodesItemsControl">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CardButton}" Tag="{Binding}" Click="DetailRelatedCard_Click" Width="258" Margin="0,0,14,14">
                                                        <StackPanel>
                                                            <Border Height="145" Background="#17FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="pack://application:,,,/Assets/emby.png" Width="38" Height="38" Opacity="0.12"/>
                                                                    <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                                                    <Border VerticalAlignment="Bottom" Background="#E6070A0E" Padding="12,9"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/></Border>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="#9FFFFFFF" FontSize="12" Margin="2,7,2,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Chapters -->
                                <StackPanel x:Name="DetailChaptersSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock Text="章节" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ItemsControl x:Name="DetailChaptersItemsControl">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#12101721" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="13" Padding="14,9" Margin="0,0,9,9">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Foreground="#FFE4EAF0"/><TextBlock Text="{Binding TimeText}" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0"/></StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Cast -->
                                <StackPanel x:Name="DetailPeopleSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock Text="演职人员" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ScrollViewer x:Name="DetailPeopleScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="DetailPeopleScroll_ScrollChanged">
                                        <ItemsControl x:Name="DetailPeopleItemsControl">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="116" Margin="0,0,16,12">
                                                        <Border Width="92" Height="92" CornerRadius="18" Background="#16FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left">
                                                            <Grid><Image Source="pack://application:,,,/Assets/emby.png" Width="30" Height="30" Opacity="0.10"/><Image Source="{Binding Image}" Stretch="UniformToFill"/></Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" Margin="1,9,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                                                        <TextBlock Text="{Binding Role}" Foreground="#FF85858B" FontSize="11" Margin="1,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Similar -->
                                <StackPanel x:Name="DetailSimilarSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock Text="相似作品" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ScrollViewer x:Name="DetailSimilarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HorizontalSection_PreviewMouseWheel" ScrollChanged="DetailSimilarScroll_ScrollChanged">
                                        <ItemsControl x:Name="DetailSimilarItemsControl">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CardButton}" Tag="{Binding}" Click="DetailRelatedCard_Click" Width="148" Margin="0,0,14,18">
                                                        <StackPanel>
                                                            <Border Height="214" Background="#17FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                                <Grid><Image Source="pack://application:,,,/Assets/emby.png" Width="38" Height="38" Opacity="0.12"/><Image Source="{Binding Image}" Stretch="UniformToFill"/></Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" Margin="2,8,2,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="White" FontSize="11" Margin="2,3,2,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Studios / locations / links -->
                                <Grid Margin="0,28,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel x:Name="DetailStudiosSection" Visibility="Collapsed">
                                        <TextBlock Text="工作室" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                        <TextBlock x:Name="DetailStudiosText" Foreground="White" FontSize="14" LineHeight="24"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DetailLocationsSection" Grid.Column="2" Visibility="Collapsed">
                                        <TextBlock Text="制作地区" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                        <TextBlock x:Name="DetailLocationsText" Foreground="White" FontSize="14" LineHeight="24"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="DetailLinksSection" Margin="0,26,0,0" Visibility="Collapsed">
                                    <TextBlock Text="链接" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ItemsControl x:Name="DetailLinksItemsControl">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}" Tag="{Binding Url}" Style="{StaticResource SecondaryButton}" Click="ExternalLink_Click" Padding="16,8" Margin="0,0,9,9" MinHeight="38"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel x:Name="DetailInfoSection" Margin="0,28,0,0" Visibility="Collapsed">
                                    <TextBlock Text="更多信息" Style="{StaticResource SectionTitle}" Foreground="White"/>
                                    <ItemsControl x:Name="DetailInfoItemsControl">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="510" MinHeight="58" Background="#0DFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="13" Padding="14,10" Margin="0,0,12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PlaybackInfo/media-source negotiation happens before the player window exists.
                         Surface that async work instead of making the detail page look frozen. -->
                    <Border x:Name="DetailPlayBusyOverlay" Visibility="Collapsed" Background="#7A050505" Panel.ZIndex="40">
                        <StackPanel Width="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="180" Height="3" IsIndeterminate="True" BorderThickness="0"/>
                            <TextBlock x:Name="DetailPlayBusyText" Text="正在准备播放…" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="正在获取媒体地址和播放能力" Foreground="#AFFFFFFF" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
