<Window x:Class="EmbyRemotePlayer.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Emby Remote · 影院播放器"
        Icon="pack://application:,,,/Assets/emby.ico"
        Width="1440" Height="860" MinWidth="840" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Black"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="PlayerSurface_PreviewMouseMove"
        SizeChanged="PlayerWindow_SizeChanged"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" BlurRadius="12" ShadowDepth="1" Opacity="0.85" Color="#000000"/>

        <!-- =================================================================== -->
        <!-- Hand-Crafted 24x24 Precision Apple TV Vector Icons                   -->
        <!-- =================================================================== -->
        <StreamGeometry x:Key="GeoPlay">M 7.5,5.2 C 7.5,4.35 8.4,3.85 9.15,4.3 L 18.2,11.1 C 18.8,11.5 18.8,12.5 18.2,12.9 L 9.15,19.7 C 8.4,20.15 7.5,19.65 7.5,18.8 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoPause">M 6.5,5 C 6.5,4.45 6.95,4 7.5,4 L 8.5,4 C 9.05,4 9.5,4.45 9.5,5 L 9.5,19 C 9.5,19.55 9.05,20 8.5,20 L 7.5,20 C 6.95,20 6.5,19.55 6.5,19 Z M 14.5,5 C 14.5,4.45 14.95,4 15.5,4 L 16.5,4 C 17.05,4 17.5,4.45 17.5,5 L 17.5,19 C 17.5,19.55 17.05,20 16.5,20 L 15.5,20 C 14.95,20 14.5,19.55 14.5,19 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoChevronLeft">M 15,19 L 8,12 L 15,5</StreamGeometry>
        <StreamGeometry x:Key="GeoSeekBackArc">M 6.8,6.8 C 9.7,3.7 14.3,3.7 17.2,6.8 C 19.8,9.5 19.5,13.8 16.5,16.2 C 14.1,18.1 10.6,18.2 8,16.5 M 6.8,3.5 L 6.8,7.5 L 10.8,7.5</StreamGeometry>
        <StreamGeometry x:Key="GeoSeekForwardArc">M 17.2,6.8 C 14.3,3.7 9.7,3.7 6.8,6.8 C 4.2,9.5 4.5,13.8 7.5,16.2 C 9.9,18.1 13.4,18.2 16,16.5 M 17.2,3.5 L 17.2,7.5 L 13.2,7.5</StreamGeometry>
        <StreamGeometry x:Key="GeoSpeakerBody">M 3.5,9 L 7.4,9 L 12,4.8 L 12,19.2 L 7.4,15 L 3.5,15 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoWaveSmall">M 14.4,9.1 C 16.2,10.6 16.2,13.4 14.4,14.9</StreamGeometry>
        <StreamGeometry x:Key="GeoWaveLarge">M 17.1,6.8 C 20.8,9.7 20.8,14.3 17.1,17.2</StreamGeometry>
        <StreamGeometry x:Key="GeoMuteSlash">M 14.7,9 L 20.2,14.5 M 20.2,9 L 14.7,14.5</StreamGeometry>
        <StreamGeometry x:Key="GeoPlaylistLines">M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 14,18</StreamGeometry>
        <StreamGeometry x:Key="GeoFullscreenBrackets">M 8,4 L 4,4 L 4,8 M 16,4 L 20,4 L 20,8 M 20,16 L 20,20 L 16,20 M 8,20 L 4,20 L 4,16</StreamGeometry>
        <StreamGeometry x:Key="GeoExitFullscreenBrackets">M 4,8 L 8,8 L 8,4 M 20,8 L 16,8 L 16,4 M 16,20 L 16,16 L 20,16 M 4,16 L 8,16 L 8,20</StreamGeometry>
        <StreamGeometry x:Key="GeoMin">M 5,12 L 19,12</StreamGeometry>
        <StreamGeometry x:Key="GeoMax">M 5,5 L 19,5 L 19,19 L 5,19 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoCloseCross">M 6,6 L 18,18 M 18,6 L 6,18</StreamGeometry>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>

        <!-- Apple TV Circular Action Button (42x42) -->
        <Style x:Key="AppleTvButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                CornerRadius="21" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple TV Primary Play Button (50x50 Glowing Azure Circle) -->
        <Style x:Key="AppleTvPlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#EE0A84FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.52" Color="#0A84FF"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Width="50" Height="50" CornerRadius="25"
                                Background="{TemplateBinding Background}" BorderBrush="#50FFFFFF" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF389FFF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aliases for backwards compatibility with C# styles -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource AppleTvButton}"/>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource AppleTvPlayButton}"/>
        <Style x:Key="RightControlButton" TargetType="Button" BasedOn="{StaticResource AppleTvButton}"/>
        <Style x:Key="SeekStepButton" TargetType="Button" BasedOn="{StaticResource AppleTvButton}"/>

        <Style x:Key="TextActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#24FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.58"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#24FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFFF453A"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- =================================================================== -->
        <!-- Apple TV Fluid Timeline Styles                                      -->
        <!-- =================================================================== -->
        <Style x:Key="LiquidPlayedTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="#FF0A84FF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiquidRemainingTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="#35FFFFFF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekThumb" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#FFFFFFFF">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.65" Color="#0A84FF"/></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="15"/>
                                <Setter TargetName="Dot" Property="Height" Value="15"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="16"/>
                                <Setter TargetName="Dot" Property="Height" Value="16"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenuService.IsEnabled" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="32" Background="Transparent" ClipToBounds="False">
                            <Track x:Name="PART_Track" Height="20" VerticalAlignment="Center" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource LiquidPlayedTrackButton}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource LiquidRemainingTrackButton}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource SeekThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume Slider Styles -->
        <Style x:Key="VolumeDecreaseTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="3.5" VerticalAlignment="Center" CornerRadius="1.75" Background="#FF0A84FF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeIncreaseTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="3.5" VerticalAlignment="Center" CornerRadius="1.75" Background="#35FFFFFF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeThumb" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="16" Height="16" Background="Transparent">
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FFFFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="12"/>
                                <Setter TargetName="Dot" Property="Height" Value="12"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="13"/>
                                <Setter TargetName="Dot" Property="Height" Value="13"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource VolumeDecreaseTrackButton}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource VolumeIncreaseTrackButton}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource VolumeThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =================================================================== -->
        <!-- Apple TV Frosted Capsule Selector (Menu / Dropdown)                 -->
        <!-- =================================================================== -->
        <Style x:Key="MenuItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="#FFFFFFFF"
                                                  TextElement.FontFamily="{StaticResource AppFontFamily}"
                                                  TextElement.FontSize="14"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="Grayscale"
                                                  TextOptions.TextHintingMode="Fixed"/>
                            </Border>
                            <Border x:Name="SelectedAccent" Width="3" Height="20" CornerRadius="1.5"
                                    Background="#FF0A84FF" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="3,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#250A84FF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#600A84FF"/>
                                <Setter TargetName="SelectedAccent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NetflixMenuCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Height="34" Background="Transparent">
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Background="Transparent" Tag="{TemplateBinding Tag}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HitArea" Background="#20FFFFFF" CornerRadius="17" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="12,0" SnapsToDevicePixels="True">
                                            <TextBlock x:Name="GlyphText" Text="{TemplateBinding Tag}" Foreground="#F5FFFFFF"
                                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HitArea" Property="Background" Value="#35FFFFFF"/>
                                                <Setter TargetName="HitArea" Property="BorderBrush" Value="#50FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HitArea" Property="Background" Value="#45FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HitArea" Property="Background" Value="#300A84FF"/>
                                                <Setter TargetName="HitArea" Property="BorderBrush" Value="#800A84FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Top" AllowsTransparency="False" Focusable="False"
                                   PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border x:Name="PopupSurface" Background="#FC111622" BorderBrush="#35FFFFFF" BorderThickness="1"
                                        CornerRadius="18" Padding="6" Margin="0,0,0,12" MinWidth="240" MaxHeight="370"
                                        Opacity="1" RenderTransformOrigin="0.5,1" SnapsToDevicePixels="True"
                                        Effect="{StaticResource GlassShadow}"
                                        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Episode List Item -->
        <Style x:Key="EpisodeItemButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding CurrentVisibility}" Value="Visible">
                                <Setter TargetName="Root" Property="Background" Value="#250A84FF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#700A84FF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OSD Controls Auto-Hide Animation -->
        <Style x:Key="PlaybackChromePanel" TargetType="Grid">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsControlsVisible}" Value="False">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" EasingFunction="{StaticResource CardEase}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource CardEase}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BufferProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="1.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- =================================================================== -->
    <!-- Video Player Root Surface                                           -->
    <!-- =================================================================== -->
    <vlc:VideoView x:Name="VideoView" Background="Black">
        <Grid Background="Transparent">

            <!-- Apple TV Subtle Top Readability Vignette (Transparent at bottom, soft dark fade at top) -->
            <Border IsHitTestVisible="False" VerticalAlignment="Top" Height="120">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#80000000" Offset="0"/>
                        <GradientStop Color="#25000000" Offset="0.6"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Apple TV Subtle Bottom Readability Vignette (100% transparent in center/subtitles, soft dark at bottom) -->
            <Border IsHitTestVisible="False" VerticalAlignment="Bottom" Height="170">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#15000000" Offset="0.38"/>
                        <GradientStop Color="#60000000" Offset="0.76"/>
                        <GradientStop Color="#96000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Playback Loading Overlay (Apple TV Minimal Glowing Ring) -->
            <Grid x:Name="LoadingOverlay" IsHitTestVisible="False" Background="#12000000">
                <StackPanel Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="52" Height="52" HorizontalAlignment="Center">
                        <Ellipse Stroke="#26FFFFFF" StrokeThickness="3.5"/>
                        <Ellipse Stroke="#FF0A84FF" StrokeThickness="3.5" StrokeDashArray="2,5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.85"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="LoadingText" Text="正在准备播放…" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" Effect="{StaticResource TextShadow}"/>
                    <TextBlock x:Name="LoadingDetailText" Text="连接媒体服务器" Foreground="#AFFFFFFF" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center"/>
                    <ProgressBar x:Name="BufferCacheProgress" Style="{StaticResource BufferProgressStyle}" Minimum="0" Maximum="100" Value="0"
                                 Width="168" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BufferCacheText" Foreground="#AFFFFFFF" FontSize="10" HorizontalAlignment="Center"
                               Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Apple TV Single-Click Center Gesture Overlay -->
            <Grid x:Name="PlaybackGestureOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="PlaybackGestureBadge" Width="72" Height="72" CornerRadius="36"
                        Background="#B20B0F18" BorderBrush="#600A84FF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.CacheMode><BitmapCache/></Border.CacheMode>
                    <Border.RenderTransform><ScaleTransform x:Name="PlaybackGestureScale" ScaleX="0.92" ScaleY="0.92"/></Border.RenderTransform>
                    <Grid Width="28" Height="28">
                        <Viewbox x:Name="PlaybackGesturePlayIcon" Width="22" Height="22" Stretch="Uniform" Visibility="Collapsed"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0">
                            <Path Fill="White" Data="{StaticResource GeoPlay}"/>
                        </Viewbox>
                        <Viewbox x:Name="PlaybackGesturePauseIcon" Width="22" Height="22" Stretch="Uniform" Visibility="Collapsed"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="White" Data="{StaticResource GeoPause}"/>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <!-- =============================================================== -->
            <!-- Apple TV Top Header Bar                                         -->
            <!-- =============================================================== -->
            <Grid x:Name="TitleBarPanel" Style="{StaticResource PlaybackChromePanel}" Height="54" VerticalAlignment="Top" Margin="24,12,24,0">
                <!-- Left: Chevron Back Button + Title + Quality Badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="2">
                    <Button Style="{StaticResource AppleTvButton}" Width="40" Height="40"
                            Command="{Binding CloseCommand}" ToolTip="返回媒体库（Esc）" AutomationProperties.Name="关闭播放器并返回媒体库">
                        <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource GeoChevronLeft}" Width="11" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="TitleText" Text="{Binding BottomTitle}" Foreground="#FFFFFFFF" FontSize="17" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="760"/>
                        <Border Background="#200A84FF" BorderBrush="#500A84FF" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModeText" Text="原画" Foreground="#FFD6EBFF" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="2">
                    <Button Style="{StaticResource WindowButton}" Command="{Binding MinimizeCommand}" ToolTip="最小化">
                        <Path Stroke="#D8FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource GeoMin}" Width="12" Height="4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowButton}" Command="{Binding ToggleFullscreenCommand}" ToolTip="全屏 / 还原（F）">
                        <Path Stroke="#D8FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource GeoMax}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CloseWindowButton}" Command="{Binding CloseCommand}" ToolTip="关闭">
                        <Path Stroke="#D8FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource GeoCloseCross}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Floating Error Toast -->
            <Border x:Name="ErrorBanner" Background="#E5B20710" BorderBrush="#44FFFFFF" BorderThickness="1"
                    Padding="18,11" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="24,68,24,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxWidth="760"/>
            </Border>

            <!-- Apple TV Floating Episode Drawer (Right Side) -->
            <Border x:Name="EpisodePanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="388" Margin="0,68,16,96" Background="#F2101622" BorderBrush="#35FFFFFF" BorderThickness="1"
                    CornerRadius="20" Padding="20,18,14,18" UseLayoutRounding="True" SnapsToDevicePixels="True"
                    Effect="{StaticResource GlassShadow}"
                    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">
                <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="接 下 来" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="剧集列表" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PreviousEpisodeButton" Content="上一集" Style="{StaticResource TextActionButton}"
                                    Height="32" MinWidth="54" Padding="10,0" FontSize="12" Visibility="Collapsed"
                                    Click="PreviousEpisodeButton_Click"/>
                            <Button x:Name="NextEpisodeButton" Content="下一集" Style="{StaticResource TextActionButton}"
                                    Height="32" MinWidth="54" Padding="10,0" FontSize="12" Visibility="Collapsed"
                                    Click="NextEpisodeButton_Click"/>
                            <Button Style="{StaticResource AppleTvButton}" Width="34" Height="34"
                                    Click="CloseEpisodePanelButton_Click" ToolTip="关闭面板">
                                <Path Stroke="#D8FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="{StaticResource GeoCloseCross}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="EpisodePanelTitleText" Grid.Row="1" Foreground="#F7FFFFFF" FontSize="13.5" FontWeight="Normal" Margin="0,4,4,12" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                    <ScrollViewer x:Name="EpisodeScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="EpisodeItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource EpisodeItemButton}" Click="EpisodeItem_Click" Tag="{Binding Item}" Margin="0,1,4,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Foreground="#F3FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                                <TextBlock Text="{Binding Title}" Foreground="#FFFFFFFF" FontSize="14.5" FontWeight="Normal" TextTrimming="CharacterEllipsis" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                                                <TextBlock Text="{Binding Meta}" Foreground="#D8FFFFFF" FontSize="12" FontWeight="Normal" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                                                <ProgressBar Height="2.5" Margin="0,7,8,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                             BorderThickness="0" Background="#28FFFFFF" Foreground="{StaticResource AccentBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="●" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                                       Visibility="{Binding CurrentVisibility}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- Apple TV Unified Bottom Control Deck                            -->
            <!-- =============================================================== -->
            <Grid x:Name="ControlsPanel" Style="{StaticResource PlaybackChromePanel}" VerticalAlignment="Bottom" Margin="32,0,32,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Apple TV Fluid Timeline (Left Time - Center Track - Right Duration) -->
                <Grid x:Name="SeekTimelineGrid" Height="36" ClipToBounds="False" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Elapsed Time on Left -->
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="{Binding CurrentTimeText}"
                               Foreground="#F0FFFFFF" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"/>

                    <!-- Center Fluid Slider + Rail -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="32">
                        <Grid x:Name="TimelineRailHost" Margin="0" IsHitTestVisible="False">
                            <Border x:Name="BufferedProgressRail" Height="4" Width="0" CornerRadius="2" Background="#40FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="PositionSlider" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0" VerticalAlignment="Center"
                                PreviewMouseMove="PositionSlider_PreviewMouseMove" MouseLeave="PositionSlider_MouseLeave"/>
                        <!-- Hidden bubble to preserve C# code compatibility -->
                        <Canvas x:Name="PlaybackTimestampCanvas" IsHitTestVisible="False" ClipToBounds="False" Visibility="Collapsed">
                            <Border x:Name="PlaybackTimestampBubble" Width="0" Height="0"/>
                        </Canvas>
                        <!-- Apple TV Hover Timecode Tooltip -->
                        <Canvas x:Name="SeekPreviewCanvas" IsHitTestVisible="False" ClipToBounds="False">
                            <Border x:Name="SeekPreviewBubble" Visibility="Collapsed" Canvas.Top="-36" Background="#E6101622" BorderBrush="#500A84FF" BorderThickness="1" CornerRadius="8" Padding="10,4" MinWidth="60">
                                <TextBlock x:Name="SeekPreviewText" Text="00:00" Foreground="White" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <Path x:Name="SeekPreviewPointer" Visibility="Collapsed" Fill="#FF0A84FF" Data="M 0,0 L 8,0 L 4,5 Z" Canvas.Top="-2"/>
                        </Canvas>
                    </Grid>

                    <!-- Total Duration / Remaining Time on Right -->
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="{Binding TotalTimeText}"
                               Foreground="#80FFFFFF" FontSize="12.5" FontWeight="Normal"
                               VerticalAlignment="Center" Margin="16,0,0,0"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"/>
                </Grid>

                <!-- Row 1: Apple TV Absolutely Symmetrical Bottom Action Bar -->
                <Grid Grid.Row="1" Height="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Volume Controls -->
                    <Border x:Name="LeftControlsGroup" Grid.Column="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="52">
                            <!-- Mute Speaker Button -->
                            <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="42" Height="42" Command="{Binding ToggleMuteCommand}" Margin="0,0,6,0"
                                    ToolTip="静音（M）" AutomationProperties.Name="切换静音">
                                <Grid Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource GeoSpeakerBody}"/>
                                    <Path x:Name="VolumeWaveSmall" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource GeoWaveSmall}"/>
                                    <Path x:Name="VolumeWaveLarge" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource GeoWaveLarge}"/>
                                    <Path x:Name="VolumeMuteSlash" Visibility="Collapsed" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource GeoMuteSlash}"/>
                                </Grid>
                            </Button>

                            <!-- Volume Slider -->
                            <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSliderStyle}" Minimum="0" Maximum="100" Width="108" Height="24" VerticalAlignment="Center"
                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                                    LostMouseCapture="VolumeSlider_LostMouseCapture" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
                        </StackPanel>
                    </Border>

                    <!-- Hidden Title Text to keep C# reference happy -->
                    <TextBlock x:Name="BottomTitleText" Grid.Column="0" Text="{Binding BottomTitle}" Visibility="Collapsed"/>

                    <!-- Center Column: Absolutely Centered Symmetrical Playback Triad -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Seek Backward 10s -->
                        <Button x:Name="SeekBackwardButton" Style="{StaticResource SeekStepButton}" Command="{Binding SeekBackwardCommand}"
                                Width="44" Height="44" Margin="0,0,16,0" ToolTip="后退 10 秒（← / J）" AutomationProperties.Name="后退十秒">
                            <Grid Width="26" Height="26" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <Path Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="{StaticResource GeoSeekBackArc}"/>
                                <TextBlock Text="10" Foreground="White" FontSize="8" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2.5,0,0"/>
                            </Grid>
                        </Button>

                        <!-- Master Play / Pause Button (Absolute Screen Center) -->
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Command="{Binding TogglePlaybackCommand}"
                                Width="52" Height="52" Margin="0,0,16,0" ToolTip="播放 / 暂停（空格）" AutomationProperties.Name="播放或暂停">
                            <Grid Width="26" Height="26">
                                <Viewbox x:Name="PlayPausePlayIcon" Width="22" Height="22" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Viewbox.Style>
                                    <Path Fill="White" Data="{StaticResource GeoPlay}"/>
                                </Viewbox>
                                <Viewbox x:Name="PlayPausePauseIcon" Width="22" Height="22" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style>
                                    <Path Fill="White" Data="{StaticResource GeoPause}"/>
                                </Viewbox>
                            </Grid>
                        </Button>

                        <!-- Seek Forward 10s -->
                        <Button x:Name="SeekForwardButton" Style="{StaticResource SeekStepButton}" Command="{Binding SeekForwardCommand}"
                                Width="44" Height="44" Margin="0" ToolTip="前进 10 秒（→ / L）" AutomationProperties.Name="前进十秒">
                            <Grid Width="26" Height="26" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <Path Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="{StaticResource GeoSeekForwardArc}"/>
                                <TextBlock Text="10" Foreground="White" FontSize="8" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2.5,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Right Group: Pure transparent container with Apple TV frosted pills -->
                    <Border x:Name="RightControlsGroup" Grid.Column="2" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            MouseEnter="RightControlsGroup_MouseEnter" MouseLeave="RightControlsGroup_MouseLeave">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="50">
                            <Border x:Name="NetworkTelemetryBorder" Background="#24FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                    CornerRadius="14" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center" MinHeight="28" Visibility="Collapsed">
                                <TextBlock x:Name="NetworkSpeedText" Text="{Binding NetworkRateText}" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                            </Border>
                            <ComboBox x:Name="AudioTracksComboBox" Tag="音轨" Style="{StaticResource NetflixMenuCombo}" Margin="3,0" Visibility="Collapsed" ToolTip="音轨" AutomationProperties.Name="选择音轨" PreviewMouseLeftButtonDown="SelectorComboBox_PreviewMouseLeftButtonDown" SelectionChanged="AudioTracksComboBox_SelectionChanged" DropDownOpened="InteractivePopup_Opened" DropDownClosed="InteractivePopup_Closed"/>
                            <ComboBox x:Name="SubtitleTracksComboBox" Tag="字幕" Style="{StaticResource NetflixMenuCombo}" Margin="3,0" Visibility="Collapsed" ToolTip="字幕（C）" AutomationProperties.Name="选择字幕" PreviewMouseLeftButtonDown="SelectorComboBox_PreviewMouseLeftButtonDown" SelectionChanged="SubtitleTracksComboBox_SelectionChanged" DropDownOpened="InteractivePopup_Opened" DropDownClosed="InteractivePopup_Closed"/>
                            <ComboBox x:Name="SpeedComboBox" Tag="1.0×" Style="{StaticResource NetflixMenuCombo}" Margin="3,0" ToolTip="播放速度（&lt; / &gt;）" AutomationProperties.Name="选择播放速度" PreviewMouseLeftButtonDown="SelectorComboBox_PreviewMouseLeftButtonDown" SelectionChanged="SpeedComboBox_SelectionChanged" DropDownOpened="InteractivePopup_Opened" DropDownClosed="InteractivePopup_Closed"/>
                            <ComboBox x:Name="MediaVersionsComboBox" Tag="版本" Style="{StaticResource NetflixMenuCombo}" Margin="3,0" Visibility="Collapsed"
                                      AutomationProperties.Name="媒体版本切换" ToolTip="切换媒体版本"
                                      PreviewMouseLeftButtonDown="SelectorComboBox_PreviewMouseLeftButtonDown" SelectionChanged="MediaVersionsComboBox_SelectionChanged"
                                      DropDownOpened="InteractivePopup_Opened" DropDownClosed="InteractivePopup_Closed"/>
                            <Button x:Name="EpisodeButton" Style="{StaticResource RightControlButton}" Visibility="Collapsed" Click="EpisodeButton_Click" Margin="3,0" ToolTip="剧集列表" AutomationProperties.Name="打开剧集列表">
                                <Path Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource GeoPlaylistLines}" Width="16" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="TranscodeButton" Content="转码" Style="{StaticResource RightControlButton}" Width="48" Visibility="Collapsed" Click="TranscodeButton_Click" Margin="3,0" ToolTip="切换转码模式" AutomationProperties.Name="切换转码模式"/>
                            <Button x:Name="FullscreenButton" Style="{StaticResource RightControlButton}" Command="{Binding ToggleFullscreenCommand}" Margin="4,0,0,0" ToolTip="全屏（F / F11）" AutomationProperties.Name="切换全屏">
                                <Grid Width="18" Height="18">
                                    <Path Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Miter"
                                          Data="{StaticResource GeoFullscreenBrackets}" Stretch="Uniform">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsFullscreen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                    <Path Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Miter"
                                          Data="{StaticResource GeoExitFullscreenBrackets}" Stretch="Uniform">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFullscreen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </vlc:VideoView>
</Window>
