<Window x:Class="EmbyRemotePlayer.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="播放器" Icon="pack://application:,,,/Assets/emby.ico"
        Width="1360" Height="820" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="Black"
        WindowStyle="None" ResizeMode="CanResize"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="PlayerSurface_PreviewMouseMove"
        SizeChanged="PlayerWindow_SizeChanged"
        TextElement.FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" BlurRadius="10" ShadowDepth="1" Opacity="0.9" Color="#000000"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Width="56" Height="56" CornerRadius="14" Background="Transparent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="IconPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="FontSize" Value="30"/>
        </Style>

        <!-- Clean 48x48 interaction target: visually frameless at rest, forgiving to click. -->
        <Style x:Key="RightControlButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Width="56" Height="56" Background="Transparent" CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="#1CFFFFFF"/>
                                <Setter TargetName="Glyph" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.58"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#20FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFE50914"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stable-layout seek thumb. The arranged Thumb size never changes, only the inner dot. -->
        <Style x:Key="LiquidPlayedTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="#FFE50914"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiquidRemainingTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="#FFFFFFFF" Opacity="0.72"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat progress thumb: no gradient, glow, or liquid distortion. -->
        <Style x:Key="SeekThumb" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#FFFFFFFF"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="14"/>
                                <Setter TargetName="Dot" Property="Height" Value="14"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="15"/>
                                <Setter TargetName="Dot" Property="Height" Value="15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenuService.IsEnabled" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30" Background="Transparent" ClipToBounds="False">
                            <Track x:Name="PART_Track" Height="22" VerticalAlignment="Center" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource LiquidPlayedTrackButton}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource LiquidRemainingTrackButton}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource SeekThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeDecreaseTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="5" VerticalAlignment="Center" CornerRadius="2.5" Background="#FFFFFFFF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeIncreaseTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="5" VerticalAlignment="Center" CornerRadius="2.5" Background="#66FFFFFF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="14"/>
                                <Setter TargetName="Dot" Property="Height" Value="14"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="15"/>
                                <Setter TargetName="Dot" Property="Height" Value="15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenuService.IsEnabled" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30" Background="Transparent" ClipToBounds="False">
                            <Track x:Name="PART_Track" Height="20" VerticalAlignment="Center" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VolumeDecreaseTrackButton}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VolumeIncreaseTrackButton}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource VolumeThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeekStepButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>


        <Style x:Key="MenuItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="17,11"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="#FFFFFFFF"
                                                  TextElement.FontFamily="Microsoft YaHei UI"
                                                  TextElement.FontSize="15"
                                                  TextElement.FontWeight="Bold"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  TextOptions.TextHintingMode="Fixed"/>
                            </Border>
                            <Border x:Name="SelectedAccent" Width="3" Height="24" CornerRadius="1.5"
                                    Background="#FFE50914" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="2,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#20FFFFFF"/>
                                <Setter TargetName="SelectedAccent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#20FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact icon-first selector. The closed state stays visually quiet like a TV player;
             the full descriptive text only appears inside the popup. -->
        <Style x:Key="NetflixMenuCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Width="56" Height="56" Background="Transparent">
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Background="Transparent" Tag="{TemplateBinding Tag}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HitArea" Background="Transparent" CornerRadius="14">
                                            <Grid Width="56" Height="56" Background="Transparent">
                                                <TextBlock x:Name="GlyphText" Text="{TemplateBinding Tag}" Foreground="#FFFFFFFF" FontFamily="Segoe UI Symbol"
                                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Tag" Value="♪">
                                                <Setter TargetName="GlyphText" Property="Margin" Value="0,-2,0,2"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="CC">
                                                <Setter TargetName="GlyphText" Property="Margin" Value="0,-1,0,1"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="1×">
                                                <Setter TargetName="GlyphText" Property="Margin" Value="0,-1,0,1"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="⇄">
                                                <Setter TargetName="GlyphText" Property="Margin" Value="0,-3,0,3"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HitArea" Property="Background" Value="#10FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HitArea" Property="Background" Value="#1CFFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HitArea" Property="Background" Value="#24FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Top" AllowsTransparency="False" Focusable="False"
                                   PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border x:Name="PopupSurface" Background="#FF171717" BorderBrush="#30FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="7" Margin="0,0,0,8" MinWidth="224" MaxHeight="350"
                                        Opacity="1" RenderTransformOrigin="0.5,1" SnapsToDevicePixels="True"
                                        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
                                    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Episode list item style. Keep this local to PlayerWindow so the lazy-created
             DataTemplate can always resolve it when the episode panel is first opened. -->
        <Style x:Key="EpisodeItemButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1EFFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding CurrentVisibility}" Value="Visible">
                                <Setter TargetName="Root" Property="Background" Value="#30E50914"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#8CE50914"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<Style x:Key="PlaybackChromePanel" TargetType="Grid">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsControlsVisible}" Value="False">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09">
                                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BufferProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Background" Value="#28FFFFFF"/>
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <vlc:VideoView x:Name="VideoView">
        <Grid Background="Transparent">
            <!-- Subtle top readability fade. -->
            <Border IsHitTestVisible="False" VerticalAlignment="Top" Height="125">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8F000000" Offset="0"/>
                        <GradientStop Color="#28000000" Offset="0.62"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Playback lifecycle feedback. This is driven by LibVLC Opening/Buffering/Playing
                 so network work never looks like a frozen black screen. -->
            <Grid x:Name="LoadingOverlay" IsHitTestVisible="False" Background="#12000000">
                <StackPanel Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="58" Height="58" HorizontalAlignment="Center">
                        <Ellipse Stroke="#26FFFFFF" StrokeThickness="4"/>
                        <Ellipse Stroke="#F6FFFFFF" StrokeThickness="4" StrokeDashArray="2,5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.85"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="LoadingText" Text="正在准备播放…" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" Effect="{StaticResource TextShadow}"/>
                    <TextBlock x:Name="LoadingDetailText" Text="连接媒体服务器" Foreground="#AFFFFFFF" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center"/>
                    <ProgressBar x:Name="BufferCacheProgress" Style="{StaticResource BufferProgressStyle}" Minimum="0" Maximum="100" Value="0"
                                 Width="168" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BufferCacheText" Foreground="#AFFFFFFF" FontSize="10" HorizontalAlignment="Center"
                               Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Single-click play/pause feedback. Render-transform only + BitmapCache keeps it on the composition path. -->
            <Grid x:Name="PlaybackGestureOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="PlaybackGestureBadge" Width="74" Height="74" CornerRadius="37"
                        Background="#64000000" BorderBrush="#16FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.CacheMode><BitmapCache/></Border.CacheMode>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PlaybackGestureScale" ScaleX="0.92" ScaleY="0.92"/>
                    </Border.RenderTransform>
                    <Grid Width="34" Height="34">
                        <Viewbox x:Name="PlaybackGesturePlayIcon" Stretch="Uniform" Visibility="Collapsed">
                            <Path Fill="White" Data="M 7,4 L 7,20 L 20,12 Z"/>
                        </Viewbox>
                        <Grid x:Name="PlaybackGesturePauseIcon" Visibility="Collapsed" Margin="7,5">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="White" CornerRadius="1"/>
                            <Border Grid.Column="2" Background="White" CornerRadius="1"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="TitleBarPanel" Style="{StaticResource PlaybackChromePanel}" Height="62" VerticalAlignment="Top" Margin="18,4,0,0">
                <Button Content="←" Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="25"
                        Command="{Binding CloseCommand}" Margin="-6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="2"/>

                <TextBlock x:Name="TitleText" Text="{Binding BottomTitle}" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="760" Margin="170,0,170,0" IsHitTestVisible="False" Panel.ZIndex="0"/>
                <TextBlock x:Name="ModeText" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="2">
                    <Button Content="—" Style="{StaticResource WindowButton}" Command="{Binding MinimizeCommand}"/>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowButton}" Command="{Binding ToggleFullscreenCommand}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Path Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 9,4 L 4,4 L 4,9 M 15,4 L 20,4 L 20,9 M 20,15 L 20,20 L 15,20 M 9,20 L 4,20 L 4,15"/>
                        </Viewbox>
                    </Button>
                    <Button Content="✕" Style="{StaticResource CloseWindowButton}" Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>

            <Border x:Name="ErrorBanner" Background="#E5B20710" BorderBrush="#44FFFFFF" BorderThickness="1"
                    Padding="18,11" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="24,72,24,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxWidth="760"/>
            </Border>

            <Border x:Name="EpisodePanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="388" Margin="0,70,14,104" Background="#FF181818" BorderBrush="#30FFFFFF" BorderThickness="1"
                    CornerRadius="12" Padding="18,16,12,16" UseLayoutRounding="True" SnapsToDevicePixels="True"
                    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
                <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="剧集" Foreground="White" FontFamily="Microsoft YaHei UI" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PreviousEpisodeButton" Content="上一集" Style="{StaticResource TextActionButton}"
                                    Height="34" MinWidth="56" Padding="10,0" FontSize="12" Visibility="Collapsed"
                                    Click="PreviousEpisodeButton_Click"/>
                            <Button x:Name="NextEpisodeButton" Content="下一集" Style="{StaticResource TextActionButton}"
                                    Height="34" MinWidth="56" Padding="10,0" FontSize="12" Visibility="Collapsed"
                                    Click="NextEpisodeButton_Click"/>
                            <Button Content="✕" Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="14"
                                    Click="CloseEpisodePanelButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="EpisodePanelTitleText" Grid.Row="1" Foreground="#F7FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="14" FontWeight="Bold" Margin="0,4,4,12" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                    <ScrollViewer x:Name="EpisodeScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="EpisodeItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource EpisodeItemButton}" Click="EpisodeItem_Click" Tag="{Binding Item}" Margin="0,1,4,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Foreground="#F3FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                                <TextBlock Text="{Binding Title}" Foreground="#FFFFFFFF" FontFamily="Microsoft YaHei UI" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                                <TextBlock Text="{Binding Meta}" Foreground="#D8FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Normal" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                                                <ProgressBar Height="2" Margin="0,7,8,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                             BorderThickness="0" Background="#28FFFFFF" Foreground="#FFE50914"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="●" Foreground="#FFE50914" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                                       Visibility="{Binding CurrentVisibility}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid x:Name="ControlsPanel" Style="{StaticResource PlaybackChromePanel}" VerticalAlignment="Bottom" Margin="32,0,32,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <!-- Playback controls sit below the progress/time area. -->
                <Grid Grid.Row="1" Height="68" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeftControlsGroup" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Height="56">
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Command="{Binding TogglePlaybackCommand}" Margin="0,0,8,0">
                            <Grid Width="30" Height="30">
                                <Viewbox x:Name="PlayPausePlayIcon" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform><TranslateTransform Y="-4"/></Viewbox.RenderTransform>
                                    <Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Viewbox.Style>
                                    <Path Fill="White" Data="M 7,4 L 7,20 L 20,12 Z"/>
                                </Viewbox>
                                <Grid x:Name="PlayPausePauseIcon" Margin="7,5">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Background="White" CornerRadius="1"/><Border Grid.Column="2" Background="White" CornerRadius="1"/>
                                </Grid>
                            </Grid>
                        </Button>

                        <Button x:Name="SeekBackwardButton" Style="{StaticResource SeekStepButton}" Command="{Binding SeekBackwardCommand}" Margin="0,0,2,0">
                            <Viewbox Width="28" Height="28" Stretch="Uniform">
                                <Grid Width="24" Height="24" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Grid Height="14" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Path Stroke="White" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 16.5,2 L 11,7.5 L 16.5,13 M 10.5,2 L 5,7.5 L 10.5,13"/>
                                    </Grid>
                                    <TextBlock Text="10" Foreground="White" FontFamily="Segoe UI" FontSize="9" FontWeight="Bold" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                                </Grid>
                            </Viewbox>
                        </Button>

                        <Button x:Name="SeekForwardButton" Style="{StaticResource SeekStepButton}" Command="{Binding SeekForwardCommand}" Margin="0,0,8,0">
                            <Viewbox Width="28" Height="28" Stretch="Uniform">
                                <Grid Width="24" Height="24" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Grid Height="14" VerticalAlignment="Top" Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="1"/></Grid.RenderTransform>
                                        <Path Stroke="White" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 16.5,2 L 11,7.5 L 16.5,13 M 10.5,2 L 5,7.5 L 10.5,13"/>
                                    </Grid>
                                    <TextBlock Text="10" Foreground="White" FontFamily="Segoe UI" FontSize="9" FontWeight="Bold" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                                </Grid>
                            </Viewbox>
                        </Button>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="56" Height="56" Command="{Binding ToggleMuteCommand}" Margin="0,0,8,0">
                            <Viewbox Width="28" Height="28" Stretch="Uniform"><Grid Width="24" Height="24"><Path Fill="White" Data="M 3.5,9 L 7.4,9 L 12,5.2 L 12,18.8 L 7.4,15 L 3.5,15 Z"/><Path x:Name="VolumeWaveSmall" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14.4,9.1 C 16.2,10.6 16.2,13.4 14.4,14.9"/><Path x:Name="VolumeWaveLarge" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 17.1,6.8 C 20.8,9.7 20.8,14.3 17.1,17.2"/><Path x:Name="VolumeMuteSlash" Visibility="Collapsed" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14.7,9 L 20.2,14.5 M 20.2,9 L 14.7,14.5"/></Grid></Viewbox>
                        </Button>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSliderStyle}" Minimum="0" Maximum="100" Width="156" Height="32" VerticalAlignment="Center" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp" LostMouseCapture="VolumeSlider_LostMouseCapture" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
                    </StackPanel>

                    <TextBlock x:Name="BottomTitleText" Grid.Column="1" Text="{Binding BottomTitle}" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" IsHitTestVisible="False"/>

                    <StackPanel x:Name="RightControlsGroup" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="56"
                                MouseEnter="RightControlsGroup_MouseEnter" MouseLeave="RightControlsGroup_MouseLeave">
                        <Border x:Name="NetworkTelemetryBorder" Background="#48101010" BorderBrush="#16FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="10,4" Margin="0,3,10,-3" VerticalAlignment="Center" MinHeight="32" Visibility="Collapsed">
                            <TextBlock x:Name="NetworkSpeedText" Text="{Binding NetworkRateText}" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"/>
                        </Border>
                        <ComboBox x:Name="AudioTracksComboBox" Tag="♪" Style="{StaticResource NetflixMenuCombo}" FontSize="23" FontWeight="Bold" Margin="2,0" Visibility="Collapsed" PreviewMouseLeftButtonDown="SelectorComboBox_PreviewMouseLeftButtonDown" SelectionChanged="AudioTracksComboBox_SelectionChanged" DropDownOpened="InteractivePopup_Opened" DropDownClosed="InteractivePopup_Closed"/>
                        <ComboBox x:Name="SubtitleTracksComboBox" Tag="CC" Style="{StaticResource NetflixMenuCombo}" FontSize="16" FontWeight="Bold" Margin="2,0" Visibility="Collapsed" PreviewMouseLeftButtonDown="SelectorComboBox_PreviewMouseLeftButtonDown" SelectionChanged="SubtitleTracksComboBox_SelectionChanged" DropDownOpened="InteractivePopup_Opened" DropDownClosed="InteractivePopup_Closed"/>
                        <ComboBox x:Name="SpeedComboBox" Tag="1×" Style="{StaticResource NetflixMenuCombo}" FontSize="17" FontWeight="Bold" Margin="2,0" PreviewMouseLeftButtonDown="SelectorComboBox_PreviewMouseLeftButtonDown" SelectionChanged="SpeedComboBox_SelectionChanged" DropDownOpened="InteractivePopup_Opened" DropDownClosed="InteractivePopup_Closed"/>
                        <ComboBox x:Name="MediaVersionsComboBox" Tag="⇄" Style="{StaticResource NetflixMenuCombo}" FontSize="23" FontWeight="Bold" Margin="2,0" Visibility="Collapsed"
                                  AutomationProperties.Name="媒体版本切换"
                                  PreviewMouseLeftButtonDown="SelectorComboBox_PreviewMouseLeftButtonDown" SelectionChanged="MediaVersionsComboBox_SelectionChanged"
                                  DropDownOpened="InteractivePopup_Opened" DropDownClosed="InteractivePopup_Closed"/>
                        <Button x:Name="EpisodeButton" Style="{StaticResource RightControlButton}" Visibility="Collapsed" Click="EpisodeButton_Click" Margin="2,0">
                            <Viewbox Width="25" Height="25" Stretch="Uniform">
                                <Grid Width="24" Height="24" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Path Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 8,6 L 21,6 M 8,12 L 21,12 M 8,18 L 21,18"/>
                                    <Ellipse Width="3" Height="3" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2.5,4.5,0,0"/>
                                    <Ellipse Width="3" Height="3" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2.5,0,0,0"/>
                                    <Ellipse Width="3" Height="3" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2.5,0,0,4.5"/>
                                </Grid>
                            </Viewbox>
                        </Button>
                        <Button x:Name="TranscodeButton" Content="⚙" Style="{StaticResource RightControlButton}" Visibility="Collapsed" Click="TranscodeButton_Click" FontSize="22" Margin="2,0"/>
                        <Button x:Name="FullscreenButton" Style="{StaticResource RightControlButton}" Command="{Binding ToggleFullscreenCommand}" Margin="2,0,0,0"><Viewbox Width="25" Height="25" Stretch="Uniform" Margin="0,-2,0,2"><Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 9,4 L 4,4 L 4,9 M 15,4 L 20,4 L 20,9 M 20,15 L 20,20 L 15,20 M 9,20 L 4,20 L 4,15"/></Viewbox></Button>
                    </StackPanel>
                </Grid>

                <!-- Progress/time region stays above the playback controls. -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="44"/></Grid.RowDefinitions>

                    <Grid x:Name="SeekTimelineGrid" Grid.Row="1" Height="44" ClipToBounds="False">
                        <Grid x:Name="TimelineRailHost" Margin="0,18,0,0" IsHitTestVisible="False"><Border x:Name="BufferedProgressRail" Height="4" Width="0" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid>
                        <Slider x:Name="PositionSlider" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" PreviewMouseMove="PositionSlider_PreviewMouseMove" MouseLeave="PositionSlider_MouseLeave"/>
                        <Canvas x:Name="PlaybackTimestampCanvas" IsHitTestVisible="False" ClipToBounds="False">
                            <Border x:Name="PlaybackTimestampBubble" Background="#08000000" CornerRadius="5" Padding="6,1" Canvas.Top="-1"><StackPanel Orientation="Horizontal"><TextBlock x:Name="CurrentTimeText" Text="{Binding CurrentTimeText}" Foreground="#E8FFFFFF" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/><TextBlock Text=" / " Foreground="#82FFFFFF" FontSize="11"/><TextBlock x:Name="TotalTimeText" Text="{Binding TotalTimeText}" Foreground="#C8FFFFFF" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border>
                        </Canvas>
                        <Canvas x:Name="SeekPreviewCanvas" IsHitTestVisible="False" ClipToBounds="False"><Border x:Name="SeekPreviewBubble" Visibility="Collapsed" Canvas.Top="-34" Background="#F3181818" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,5" MinWidth="60"><TextBlock x:Name="SeekPreviewText" Text="00:00" Foreground="White" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border><Path x:Name="SeekPreviewPointer" Visibility="Collapsed" Fill="#F3181818" Data="M 0,0 L 10,0 L 5,6 Z" Canvas.Top="-2"/></Canvas>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </vlc:VideoView>
</Window>
