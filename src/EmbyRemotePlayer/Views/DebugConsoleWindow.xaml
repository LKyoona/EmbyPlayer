<Window x:Class="EmbyRemotePlayer.Views.DebugConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Inspector" Icon="pack://application:,,,/Assets/emby.ico" Width="1260" Height="790" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#FF111318"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="DevPanel" Color="#FF17191F"/>
        <SolidColorBrush x:Key="DevPanelAlt" Color="#FF1D2027"/>
        <SolidColorBrush x:Key="DevBorder" Color="#FF30343C"/>
        <SolidColorBrush x:Key="DevMuted" Color="#FF949AA7"/>
        <SolidColorBrush x:Key="DevText" Color="#FFE8EAED"/>
        <SolidColorBrush x:Key="DevBlue" Color="#FF8AB4F8"/>
        <SolidColorBrush x:Key="DevRed" Color="#FFF28B82"/>
        <SolidColorBrush x:Key="DevGreen" Color="#FF81C995"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DevText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#FF292C33"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#FF343840"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource DevMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#FF262930"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DevBlue}"/>
                                <Setter TargetName="Root" Property="Background" Value="#1F8AB4F8"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#558AB4F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#FF17191F" BorderBrush="{StaticResource DevBorder}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="5,0"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DevTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource DevMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Underline" Height="2" Background="Transparent" VerticalAlignment="Bottom"/>
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource DevText}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DevBlue}"/>
                                <Setter TargetName="Underline" Property="Background" Value="{StaticResource DevBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource DevPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource DevText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1B1D23"/>
            <Setter Property="Foreground" Value="{StaticResource DevMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DevBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource DevPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource DevText}"/>
            <Setter Property="BorderBrush" Value="#FF25282F"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#FF191B21"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF24272E"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FF253553"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FF111318">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <!-- DevTools-like toolbar -->
        <Border Background="#FF1B1D23" BorderBrush="{StaticResource DevBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="●" Foreground="{StaticResource DevRed}" Style="{StaticResource ToolbarButton}" ToolTip="网络记录中" IsEnabled="False"/>
                <Button Grid.Column="1" Content="清空" Style="{StaticResource ToolbarButton}" Click="ClearButton_Click"/>
                <Border Grid.Column="2" MaxWidth="500" Margin="8,6" HorizontalAlignment="Stretch"
                        Background="#FF25272D" BorderBrush="#FF353942" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <TextBox x:Name="FilterTextBox" Style="{x:Null}" Background="Transparent" Foreground="{StaticResource DevText}" CaretBrush="White"
                                 BorderThickness="0" Padding="9,4" FontSize="12" TextChanged="FilterTextBox_TextChanged"/>
                        <TextBlock x:Name="FilterHint" Text="Filter · URL / 接口 / 方法 / 状态" Foreground="#FF777D88" Margin="10,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="复制 cURL" Style="{StaticResource ToolbarButton}" Click="CopyCurlButton_Click" ToolTip="复制当前请求（敏感头已移除）"/>
                    <Button Content="复制详情" Style="{StaticResource ToolbarButton}" Click="CopyDetailsButton_Click" ToolTip="复制当前接口的 Headers / Payload / Response / Timing"/>
                    <Button Content="复制响应" Style="{StaticResource ToolbarButton}" Click="CopyResponseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Resource filters -->
        <Border Grid.Row="1" Background="#FF17191F" BorderBrush="{StaticResource DevBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,5" VerticalAlignment="Center">
                <ToggleButton x:Name="FilterAllButton" Content="All" Tag="all" IsChecked="True" Style="{StaticResource FilterButton}" Click="ResourceFilter_Click"/>
                <ToggleButton Content="Fetch/XHR" Tag="xhr" Style="{StaticResource FilterButton}" Click="ResourceFilter_Click"/>
                <ToggleButton Content="Media" Tag="media" Style="{StaticResource FilterButton}" Click="ResourceFilter_Click"/>
                <ToggleButton Content="Img" Tag="image" Style="{StaticResource FilterButton}" Click="ResourceFilter_Click"/>
                <ToggleButton Content="Errors" Tag="errors" Style="{StaticResource FilterButton}" Click="ResourceFilter_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" MinWidth="390"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0.9*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Request table -->
            <DataGrid x:Name="RequestGrid" Grid.Column="0" Background="{StaticResource DevPanel}" Foreground="{StaticResource DevText}"
                      BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                      CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="None" IsReadOnly="True" SelectionMode="Single"
                      RowHeaderWidth="0" AlternationCount="2" SelectionChanged="RequestGrid_SelectionChanged" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding IdText}" Width="64"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="120"/>
                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="74"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="72"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="88"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="78"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="82"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FF25282F" ShowsPreview="True"/>

            <!-- Request details -->
            <Border Grid.Column="2" Background="{StaticResource DevPanel}" BorderBrush="{StaticResource DevBorder}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Padding="12,9" Background="#FF1B1D23" BorderBrush="{StaticResource DevBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SelectedMethodText" Text="—" Foreground="{StaticResource DevBlue}" FontWeight="SemiBold"/>
                                <TextBlock Text="  "/>
                                <TextBlock x:Name="SelectedStatusText" Text="选择一个请求查看详情" Foreground="{StaticResource DevMuted}"/>
                            </StackPanel>
                            <TextBox x:Name="SelectedUrlTextBox" Grid.Row="1" Style="{x:Null}" Background="Transparent" Foreground="#FFB9BEC8"
                                     BorderThickness="0" Padding="0,5,0,0" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>

                    <TabControl x:Name="DetailsTabs" Grid.Row="1" Background="{StaticResource DevPanel}" BorderThickness="0" Padding="0">
                        <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource DevTabItem}"/></TabControl.Resources>
                        <TabItem Header="Headers">
                            <TextBox x:Name="HeadersTextBox" Style="{StaticResource InspectorTextBox}"/>
                        </TabItem>
                        <TabItem Header="Payload">
                            <TextBox x:Name="PayloadTextBox" Style="{StaticResource InspectorTextBox}"/>
                        </TabItem>
                        <TabItem Header="Response">
                            <TextBox x:Name="ResponseTextBox" Style="{StaticResource InspectorTextBox}"/>
                        </TabItem>
                        <TabItem Header="Timing">
                            <TextBox x:Name="TimingTextBox" Style="{StaticResource InspectorTextBox}"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#FF17191F" BorderBrush="{StaticResource DevBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="9,0">
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource DevMuted}" FontSize="11" VerticalAlignment="Center" Text="0 requests"/>
                <TextBlock Text="F12 打开 · Token / 密码自动脱敏 · JSON Unicode 转为可读中文" Foreground="#FF777D88" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
