        <StreamGeometry x:Key="GeoPlaylist">M 4,6 L 20,6 L 20,8 L 4,8 Z M 4,11 L 20,11 L 20,13 L 4,13 Z M 4,16 L 14,16 L 14,18 L 4,18 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoSpeed">M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 12,20 C 7.58,20 4,16.42 4,12 C 4,7.58 7.58,4 12,4 C 16.42,4 20,7.58 20,12 C 20,16.42 16.42,20 12,20 Z M 12.5,7 L 11,7 L 11,13 L 16.25,16.15 L 17,14.92 L 12.5,12.25 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoServer">M 4,4 L 20,4 C 21.1,4 22,4.9 22,6 L 22,8 C 22,9.1 21.1,10 20,10 L 4,10 C 2.9,10 2,9.1 2,8 L 2,6 C 2,4.9 2.9,4 4,4 Z M 4,14 L 20,14 C 21.1,14 22,14.9 22,16 L 22,18 C 22,19.1 21.1,20 20,20 L 4,20 C 2.9,20 2,19.1 2,18 L 2,16 C 2,14.9 2.9,14 4,14 Z M 6,6 L 8,6 L 8,8 L 6,8 Z M 6,16 L 8,16 L 8,18 L 6,18 Z</StreamGeometry>
