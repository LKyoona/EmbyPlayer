<Application x:Class="EmbyRemotePlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Comfortable Liquid Glass Cinema Palette (Apple VisionOS / Liquid Glass style) -->
        <Color x:Key="PageColor">#FF080C14</Color>
        <Color x:Key="SurfaceColor">#FF121722</Color>
        <Color x:Key="SurfaceAltColor">#FF182030</Color>
        <Color x:Key="TextColor">#FFF6F8FA</Color>
        <Color x:Key="TextMutedColor">#FF98A2B3</Color>
        <Color x:Key="BorderColor">#28FFFFFF</Color>
        <Color x:Key="AccentColor">#FF0A84FF</Color>
        <Color x:Key="AccentHoverColor">#FF389FFF</Color>
        <Color x:Key="SuccessColor">#FF30D158</Color>
        <Color x:Key="DangerColor">#FFFF453A</Color>

        <SolidColorBrush x:Key="PageBrush" Color="#FF080C14"/>
        <SolidColorBrush x:Key="GlassBrush" Color="#EE101622"/>
        <SolidColorBrush x:Key="GlassBrightBrush" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF389FFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="36" ShadowDepth="12" Direction="270" Opacity="0.65" Color="#000000"/>
        <DropShadowEffect x:Key="GlassShadow" BlurRadius="54" ShadowDepth="14" Direction="270" Opacity="0.75" Color="#000000"/>
        <DropShadowEffect x:Key="AccentGlow" BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="#0A84FF"/>
        <CubicEase x:Key="CardEase" EasingMode="EaseOut"/>

