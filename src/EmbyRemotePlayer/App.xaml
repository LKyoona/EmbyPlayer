        <StreamGeometry x:Key="GeoVolumeMute">M 3,9 L 7,9 L 12,4 L 12,20 L 7,15 L 3,15 Z M 16.29,12 L 14.71,10.41 L 13.29,11.83 L 14.71,13.24 L 13.29,14.66 L 14.71,16.07 L 16.12,14.66 L 17.54,16.07 L 18.95,14.66 L 17.54,13.24 L 18.95,11.83 L 17.54,10.41 Z M 19.07,4.93 L 4.93,19.07 L 6.34,20.49 L 20.49,6.34 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoFullscreen">M 7,14 L 5,14 L 5,19 L 10,19 L 10,17 L 7,17 Z M 5,10 L 7,10 L 7,7 L 10,7 L 10,5 L 5,5 Z M 17,17 L 14,17 L 14,19 L 19,19 L 19,14 L 17,14 Z M 14,5 L 14,7 L 17,7 L 17,10 L 19,10 L 19,5 Z</StreamGeometry>
